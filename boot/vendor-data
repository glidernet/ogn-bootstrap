chmod 0755 /usr/local/sbin/ogn-install

cat > /usr/local/sbin/ogn-update <<'OGN_PAYLOAD_ogn_update'
#!/bin/bash
#
# ogn-update — install or upgrade the OGN decoder binaries.
#
#   sudo ogn-update --check          report what is installed and available
#   sudo ogn-update                  upgrade to the configured channel
#   sudo ogn-update --channel 0.3.2  install one exact version
#
# Integrity comes from versions.json, fetched from GitHub over TLS. The
# binaries themselves come from download.glidernet.org, which has no working
# HTTPS at all — and, worse, answers port 443 with cleartext, so a naive
# "try TLS, fall back" would look like it had worked. The SHA256 in the
# manifest is what actually protects this; upstream's MD5 is checked as well,
# but only to catch a corrupt download.
#
# Copyright (c) 2026 ifly7charlie. MIT licence, see LICENSE.

set -euo pipefail

LIBDIR="${OGN_LIBDIR:-/usr/local/lib/ogn-bootstrap}"
# shellcheck source=src/ogn-common.sh
. "$LIBDIR/ogn-common.sh"

CHANNEL=""
CHECK_ONLY=0
INSTALL_ONLY=0
while [ $# -gt 0 ]; do
    case "$1" in
        --channel)      CHANNEL="$2"; shift 2 ;;
        --check)        CHECK_ONLY=1; shift ;;
        --install-only) INSTALL_ONLY=1; shift ;;
        -h|--help)      sed -n '3,16p' "$0"; exit 0 ;;
        *)              die "unknown option: $1" ;;
    esac
done

[ "$CHECK_ONLY" -eq 1 ] || need_root

if [ -z "${OGN_USER:-}" ]; then
    OGN_USER=$(detect_ogn_user) || die "could not work out which account to install for"
fi
[ -n "${OGN_HOME:-}" ] || OGN_HOME=$(user_home "$OGN_USER")
OGN_GROUP=$(id -gn "$OGN_USER" 2>/dev/null || printf "%s" "$OGN_USER")
LINK="$OGN_HOME/rtlsdr-ogn"

if [ -z "$CHANNEL" ]; then
    if [ -r "$BOOT_CONF" ]; then
        conf_load "$BOOT_CONF"
        CHANNEL=$(conf_get Install.UpdateChannel stable)
    else
        CHANNEL=stable
        # The boot partition is mounted root-only, so this is the ordinary case
        # for a --check run by hand. Say which channel is being assumed rather
        # than reporting against one the card may not have asked for.
        [ "$(id -u)" -eq 0 ] \
            || warn "cannot read $BOOT_CONF as this user; reporting against the '$CHANNEL' channel"
    fi
fi

installed_version() {
    local target
    [ -L "$LINK" ] || { printf 'none'; return; }
    target=$(basename "$(readlink -f "$LINK")")
    printf '%s' "${target#rtlsdr-ogn-}"
}

INSTALLED=$(installed_version)

manifest_fetch || die "could not fetch the version manifest from $MANIFEST_URL, and no cached copy exists"
WANTED=$(manifest_resolve "$CHANNEL") \
    || die "'$CHANNEL' is not a known channel or version in the manifest"

ARCH=$(ogn_arch)

if [ "$CHECK_ONLY" -eq 1 ]; then
    printf 'installed=%s\nchannel=%s\navailable=%s\n' "$INSTALLED" "$CHANNEL" "$WANTED"
    [ "$INSTALLED" = "$WANTED" ] && exit 0 || exit 10
fi

if [ "$INSTALLED" = "$WANTED" ]; then
    log "rtlsdr-ogn $WANTED is already installed"
    exit 0
fi

URL=$(manifest_field    "$WANTED" "$ARCH" url)    || die "the manifest has no $ARCH build for $WANTED"
SHA=$(manifest_field    "$WANTED" "$ARCH" sha256) || die "the manifest has no SHA256 for $WANTED/$ARCH"
MD5=$(manifest_field    "$WANTED" "$ARCH" md5 2>/dev/null || true)

case "$SHA" in
    ""|None|null|*[!0-9a-fA-F]*)
        die "versions.json has no SHA256 for $WANTED/$ARCH, so the download cannot be verified.
     Refusing to install. Populate it with:  tools/add-version $WANTED" ;;
esac
[ "${#SHA}" -eq 64 ] || die "the manifest SHA256 for $WANTED/$ARCH is not 64 hex characters"

TMP=$(mktemp -d)
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT

log "downloading rtlsdr-ogn $WANTED ($ARCH)"
fetch "$URL" "$TMP/ogn.tgz" || die "download failed: $URL"
verify_md5    "$TMP/ogn.tgz" "$MD5" || die "download appears corrupt"
verify_sha256 "$TMP/ogn.tgz" "$SHA"
log "checksum verified"

# The upstream tarball contains rtlsdr-ogn-<version>/ *and* a sibling symlink
# named rtlsdr-ogn pointing at it. Unpacked into the home directory that gives
# exactly the versioned-directory-plus-symlink layout the fleet already uses,
# so we let it, but extract to a staging area first so a failed download can
# never leave a half-replaced install behind.
tar xzf "$TMP/ogn.tgz" -C "$TMP"
NEWDIR="$TMP/rtlsdr-ogn-$WANTED"
[ -d "$NEWDIR" ] || die "the tarball did not contain rtlsdr-ogn-$WANTED as expected"

DEST="$OGN_HOME/rtlsdr-ogn-$WANTED"
if [ -d "$DEST" ]; then
    log "replacing the existing $DEST"
    rm -rf "$DEST"
fi
cp -a "$NEWDIR" "$DEST"
chown -R "$OGN_USER:$OGN_GROUP" "$DEST"

# Carry the configuration and the geoid grid across from the previous version,
# so an upgrade never loses the site's settings.
if [ -L "$LINK" ]; then
    OLD=$(readlink -f "$LINK")
    for keep in MyReceiver.conf WW15MGH.DAC; do
        if [ -s "$OLD/$keep" ] && [ ! -s "$DEST/$keep" ]; then
            cp -a "$OLD/$keep" "$DEST/$keep"
            chown "$OGN_USER:$OGN_GROUP" "$DEST/$keep"
            log "carried $keep over from $(basename "$OLD")"
        fi
    done
fi

# ogn-rf and gsm_scan need root to reach the GPU and to mmap; upstream ships
# them expecting setuid.
for b in ogn-rf gsm_scan; do
    if [ -f "$DEST/$b" ]; then
        chown root:root "$DEST/$b"
        chmod a+s "$DEST/$b"
    fi
done
[ -p "$DEST/ogn-rf.fifo" ] || { rm -f "$DEST/ogn-rf.fifo"; mkfifo -m 0600 "$DEST/ogn-rf.fifo"; }
chown "$OGN_USER:$OGN_GROUP" "$DEST/ogn-rf.fifo"

ln -sfn "$DEST" "$LINK"
chown -h "$OGN_USER:$OGN_GROUP" "$LINK"
log "installed rtlsdr-ogn $WANTED at $DEST"

if [ "$INSTALL_ONLY" -eq 0 ] && systemctl is-enabled --quiet rtlsdr-ogn.service 2>/dev/null; then
    log "restarting the receiver"
    systemctl restart rtlsdr-ogn.service
fi
OGN_PAYLOAD_ogn_update
chmod 0755 /usr/local/sbin/ogn-update

cat > /usr/local/sbin/ogn-maintenance <<'OGN_PAYLOAD_ogn_maintenance'
#!/bin/bash
#
# ogn-maintenance — apply updates in a window where the filesystem is writable.
#
#   sudo ogn-maintenance --now          run the cycle immediately
#   sudo ogn-maintenance --status       show where the cycle has got to
#   sudo ogn-maintenance --config-sync  re-read MyReceiver.conf from the card
#
# With the read-only overlay active, writes to the root filesystem go to RAM
# and are thrown away at reboot, so updates have to happen with the overlay
# out of the way. That means a two-reboot cycle:
#
#   overlay on  -> disable overlay, reboot
#   overlay off -> apt security updates, ogn-update, enable overlay, reboot
#   overlay on  -> normal running
#
# The state marker lives on the boot partition, which sits outside the root
# overlay, so it survives the reboots that the cycle depends on. Every step
# checks the marker first, so an interruption at any point resumes or aborts
# to a known state rather than leaving the receiver unprotected.
#
# Copyright (c) 2026 ifly7charlie. MIT licence, see LICENSE.

set -euo pipefail

LIBDIR="${OGN_LIBDIR:-/usr/local/lib/ogn-bootstrap}"
# shellcheck source=src/ogn-common.sh
. "$LIBDIR/ogn-common.sh"

STATE_FILE="$STATE_DIR/maintenance.state"
UPDATE_MOTD=/etc/motd.d/20-ogn-updates
MAX_ATTEMPTS=3

state_read()  { [ -r "$STATE_FILE" ] && cut -d' ' -f1 "$STATE_FILE" || printf 'idle'; }
state_count() { [ -r "$STATE_FILE" ] && cut -d' ' -f2 "$STATE_FILE" || printf '0'; }
state_write() { printf '%s %s %s\n' "$1" "${2:-0}" "$(date -Is)" | boot_write "$STATE_FILE"; }
# Only ever touch the card if there is actually something to remove: this runs
# on every boot, and an unconditional rm is still a write to a FAT partition.
state_clear() {
    [ -e "$STATE_FILE" ] || return 0
    boot_rw; rm -f "$STATE_FILE"; boot_ro
}

# --- overlay -------------------------------------------------------------
# The mechanism lives in ogn-common.sh, shared with the `overlay` command, so
# the two cannot disagree about what "enabled" means.
overlay_set() {
    local want="$1"
    if [ "$want" = enable ]; then
        overlay_ensure_initramfs || { warn "could not arrange for an initramfs"; return 1; }
        overlay_preflight        || { warn "not enabling an overlay that would not engage"; return 1; }
        swap_disable
        cmdline_write "$OVERLAY_PARAM" 1
    else
        cmdline_write "$OVERLAY_PARAM" 0
    fi
}

# --- the actual updating -------------------------------------------------
do_updates() {
    # A kernel or firmware package writes to /boot/firmware, so open it for the
    # duration of the pass rather than per-file.
    boot_rw
    log "applying security updates"
    apt_wait
    DEBIAN_FRONTEND=noninteractive apt-get update -qq || warn "apt-get update failed; continuing"
    apt_wait
    unattended-upgrade -v 2>&1 | sed 's/^/  /' || warn "unattended-upgrade reported a problem; continuing"

    log "checking for a new OGN release"
    if ogn-update; then
        log "OGN software is up to date"
    else
        warn "ogn-update failed; the previously installed version is still in place"
    fi
    boot_ro
}

report_available() {
    local out installed available
    if ! out=$(ogn-update --check 2>/dev/null); then
        installed=$(printf '%s' "$out" | sed -n 's/^installed=//p')
        available=$(printf '%s' "$out" | sed -n 's/^available=//p')
        if [ -n "$available" ] && [ "$installed" != "$available" ]; then
            mkdir -p "$(dirname "$UPDATE_MOTD")"
            cat > "$UPDATE_MOTD" <<EOF

  OGN $installed is installed; $available is available.
  It will be installed automatically in the next maintenance window,
  or now with:  sudo ogn-maintenance --now

EOF
            log "update available: $installed -> $available"
            return 0
        fi
    fi
    rm -f "$UPDATE_MOTD"
    return 0
}

# --- configuration resync -------------------------------------------------
#
# The receiver runs from a copy of MyReceiver.conf taken at install time. On a
# read-only receiver the card is the only copy anyone can still edit, so it is
# the one that wins. Runs early, before the receiver starts and before anything
# waits on the network -- which is the point for the wifi.
config_sync() {
    local user group home link real target call lat lon old_freq

    # Before anything that can bail out: this runs at every boot, including the
    # middle boot of a maintenance cycle where the receiver is writable. The
    # published state is what `overlay status` reads without sudo, now that the
    # boot partition it would otherwise read is root-only.
    overlay_motd_update
    overlay_state_publish

    [ -r "$BOOT_CONF" ] || { log "no $BOOT_CONF on the card; nothing to sync"; return 0; }
    trap conf_cleanup EXIT
    conf_load "$BOOT_CONF"

    # Wifi first and unconditionally: under the overlay NetworkManager's
    # keyfiles are in RAM, so "unchanged" does not mean "still applied".
    # wifi_apply is itself a no-op when the live config already matches.
    wifi_apply

    # WireGuard belongs to ogn-wireguard.service, which waits for the network
    # -- exactly what this must not do. What is left for here is the edit
    # applied to a receiver that is already up: `ogn-maintenance --config-sync`
    # by hand, with a tunnel running that the card has just changed. At boot
    # the interface does not exist yet, so this stays out of the way.
    if wg_up; then
        ogn-wireguard --config "$BOOT_CONF" --apply \
            || warn "could not re-apply Network.WireGuard; see journalctl -u ogn-wireguard"
    fi

    # ADS-B has the same shape: ogn-adsb.service waits for the network, so at
    # boot this leaves it alone. On a card edit applied by hand to a running
    # receiver, readsb is already up and this is what notices.
    if systemctl is-active --quiet readsb 2>/dev/null; then
        ogn-adsb --config "$BOOT_CONF" --apply \
            || warn "could not re-apply ADSB; see journalctl -u ogn-adsb"
    fi

    # Before the digest, and before the receiver starts: nothing else has the
    # SDR yet. Disarms itself, so this is a no-op on all but the asked-for boot.
    ogn-calibrate --from-config || true
    conf_load "$BOOT_CONF"

    local want_all
    want_all=$(conf_digest)

    user=$(detect_ogn_user) || { warn "could not work out which account to sync for"; return 0; }
    home=$(user_home "$user")
    link="$home/rtlsdr-ogn"
    # Not installed yet -- first boot has not finished, and ogn-install will
    # place the file itself.
    [ -d "$link" ] || return 0
    real=$(readlink -f "$link")
    target="$real/MyReceiver.conf"

    if [ "$want_all" = "$(cat "$CONFIG_APPLIED" 2>/dev/null || true)" ] && [ -s "$target" ]; then
        return 0
    fi

    # An edited card is unreviewed input arriving unattended. Same checks the
    # installer applies, so a typo cannot take a working receiver off the air.
    call=$(conf_get APRS.Call "")
    [ -n "$call" ] || call=$(hostname -s)
    if ! printf '%s' "$call" | grep -Eq '^[A-Za-z0-9]{1,9}$'; then
        warn "the MyReceiver.conf on the card names the receiver '$call', which is not valid"
        warn "keeping the settings that are already installed"
        return 0
    fi
    lat=$(conf_get Position.Latitude 0)
    lon=$(conf_get Position.Longitude 0)
    if ! printf '%s' "$lat$lon" | grep -Eq '^[-+0-9.]+$' \
       || awk "BEGIN{exit !($lat == 0 && $lon == 0)}" 2>/dev/null \
       || awk "BEGIN{exit !($lat < -90 || $lat > 90 || $lon < -180 || $lon > 180)}" 2>/dev/null; then
        warn "the MyReceiver.conf on the card has no usable position ($lat, $lon)"
        warn "keeping the settings that are already installed"
        return 0
    fi

    # FreqCorr lives on the card now. This carries one forward for receivers
    # set up before that was true, where it only reached the installed copy.
    old_freq=""
    [ -s "$target" ] && old_freq=$(sed -n 's/^ *FreqCorr *= *\([+-]\{0,1\}[0-9]\{1,\}\).*/\1/p' "$target" | head -1)

    log "MyReceiver.conf on the card has changed; updating $target"
    group=$(id -gn "$user")
    install -o "$user" -g "$group" -m 0644 "$BOOT_CONF" "$target"

    if [ -z "$(conf_get APRS.Call "")" ]; then
        sed -i "s|^\( *Call *= *\)\"\"|\1\"$call\"|" "$target"
    fi
    if ! conf_has RF.FreqCorr && [ -n "$old_freq" ]; then
        sed -i "s|^\( *SampleRate *=\)|  FreqCorr = $old_freq;   # measured by ogn-calibrate\n\1|" "$target"
    fi
    conf_redact_secrets "$target"

    printf '%s\n' "$want_all" | boot_write "$CONFIG_APPLIED"

    # At boot it has not started yet, so it simply starts with the new file.
    # Run by hand, this picks the change up straight away.
    if systemctl is-active --quiet rtlsdr-ogn.service; then
        log "restarting the receiver with the new settings"
        systemctl restart rtlsdr-ogn.service
    fi
}

# --- cycle ---------------------------------------------------------------
begin_cycle() {
    local attempts
    if [ "$(state_read)" != "idle" ]; then
        log "a maintenance cycle is already in progress ($(state_read)); not starting another"
        return 0
    fi
    if ! overlay_active; then
        # Nothing to work around — just update in place.
        log "overlay is not active; updating without rebooting"
        do_updates
        state_clear
        return 0
    fi
    attempts=$(( $(state_count) + 1 ))
    log "disabling the read-only overlay and rebooting to apply updates"
    state_write updating "$attempts"
    # Warn rather than abort: resume_cycle re-checks after the reboot.
    overlay_set disable || warn "could not disable the overlay; the cycle will abort after the reboot"
    systemctl reboot
}

resume_cycle() {
    local attempts
    attempts=$(state_count)
    if [ "$attempts" -gt "$MAX_ATTEMPTS" ]; then
        warn "maintenance has failed $attempts times; giving up and restoring the overlay"
        state_write restoring "$attempts"
        overlay_set enable || warn "the overlay could not be re-enabled; this receiver will come up WRITABLE"
        state_clear
        systemctl reboot
        return 0
    fi
    if overlay_active; then
        # We asked for the overlay to be off and it is still on: the disable
        # did not take. Restore a known state rather than looping.
        warn "expected the overlay to be off after rebooting, but it is active; aborting this cycle"
        state_clear
        return 0
    fi
    log "maintenance pass (attempt $attempts)"
    do_updates
    log "re-enabling the read-only overlay and rebooting"
    state_write restoring "$attempts"
    overlay_set enable || warn "the overlay could not be re-enabled; this receiver will come up WRITABLE"
    state_clear
    systemctl reboot
}

# The Install section -- packages, the overlay, the maintenance window -- is
# not something a file copy can change, so a change there re-runs the
# installer. Here rather than in config_sync because ogn-install needs a
# network. Always --no-reboot: RebootWhenDone defaults true, and rebooting
# before the marker is written is how you build a boot loop.
install_check() {
    local want have
    [ -r "$BOOT_CONF" ] || return 0
    trap conf_cleanup EXIT
    conf_load "$BOOT_CONF"
    want=$(conf_digest Install)
    have=$(cat "$INSTALL_APPLIED" 2>/dev/null || true)

    [ "$want" = "$have" ] && return 0

    # No marker: a receiver installed before this existed. Adopt its current
    # state rather than re-running the installer under someone unasked.
    if [ -z "$have" ]; then
        log "recording the current Install settings as applied"
        printf '%s\n' "$want" | boot_write "$INSTALL_APPLIED"
        return 0
    fi

    log "the Install settings on the card have changed; re-running the installer"
    if ogn-install --no-reboot; then
        printf '%s\n' "$want" | boot_write "$INSTALL_APPLIED"
        log "installer finished; reboot if you changed ReadOnlyFS"
    else
        warn "ogn-install failed; the receiver is still running its previous setup"
        warn "the card will be tried again at the next boot"
    fi
}

boot_check() {
    case "$(state_read)" in
        updating)
            resume_cycle
            ;;
        restoring)
            # We were interrupted between enabling the overlay and rebooting.
            if overlay_next_boot; then
                log "maintenance finished"
                state_clear
            else
                warn "the overlay was not re-enabled after maintenance; re-enabling now"
                overlay_set enable || warn "the overlay could not be re-enabled; this receiver will come up WRITABLE"
                state_clear
                systemctl reboot
            fi
            ;;
        *)
            state_clear
            install_check
            report_available
            ;;
    esac
}

# --- entry point ---------------------------------------------------------
MODE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --scheduled)      MODE=scheduled ;;
        --boot-check)     MODE=boot-check ;;
        --config-sync)    MODE=config-sync ;;
        --now)            MODE=now ;;
        --status)         MODE=status ;;
        --overlay-status) MODE=overlay-status ;;
        --overlay-enable) MODE=overlay-enable ;;
        --overlay-disable) MODE=overlay-disable ;;
        -h|--help)        sed -n '3,21p' "$0"; exit 0 ;;
        *)                die "unknown option: $1" ;;
    esac
    shift
done

case "$MODE" in
    overlay-status) overlay_status; exit 0 ;;
    status)
        # The markers are on the boot partition, which is mounted root-only.
        # Saying "idle" to someone who simply cannot see them would be a wrong
        # answer dressed as a reassuring one.
        if [ "$(id -u)" -eq 0 ] || [ -r "$STATE_DIR" ]; then
            printf 'state:   %s (since %s)\n' "$(state_read)" "$([ -r "$STATE_FILE" ] && cut -d' ' -f3 "$STATE_FILE" || printf 'n/a')"
        else
            printf 'state:   unknown — the boot partition is readable only by root\n'
            printf '         For a definite answer:  sudo ogn-maintenance --status\n'
        fi
        printf 'overlay: %s\n' "$(overlay_status)"
        if [ "$(id -u)" -eq 0 ] || [ -r "$MANIFEST_CACHE" ]; then
            ogn-update --check || true
        fi
        exit 0 ;;
esac

need_root

case "$MODE" in
    # For the installer; `overlay on` is the front end for people.
    overlay-enable)  overlay_set enable ;;
    overlay-disable) overlay_set disable ;;
    boot-check)      boot_check ;;
    config-sync)     config_sync ;;
    scheduled|now)   begin_cycle ;;
    *)               die "say what to do: --now, --status, --config-sync, or --boot-check" ;;
esac
OGN_PAYLOAD_ogn_maintenance
chmod 0755 /usr/local/sbin/ogn-maintenance

cat > /usr/local/sbin/ogn-remote-admin <<'OGN_PAYLOAD_ogn_remote_admin'
#!/bin/bash
#
# ogn-remote-admin — optional remote access, driven by Install.RemoteAdmin.
#
# Everything here is off unless the operator turned it on. That is a
# deliberate departure from the older OGN images, which shipped third-party
# access enabled by default. Remote access to a machine on someone's club
# network should be a decision somebody made on purpose.
#
# Copyright (c) 2026 ifly7charlie. MIT licence, see LICENSE.

set -euo pipefail

LIBDIR="${OGN_LIBDIR:-/usr/local/lib/ogn-bootstrap}"
# shellcheck source=src/ogn-common.sh
. "$LIBDIR/ogn-common.sh"

CONF="$BOOT_CONF"
USER_NAME=""
while [ $# -gt 0 ]; do
    case "$1" in
        --config) CONF="$2"; shift 2 ;;
        --user)   USER_NAME="$2"; shift 2 ;;
        -h|--help) sed -n '3,9p' "$0"; exit 0 ;;
        *) die "unknown option: $1" ;;
    esac
done

need_root
[ -n "$USER_NAME" ] || USER_NAME=$(detect_ogn_user) || die "could not determine the user"
HOME_DIR=$(user_home "$USER_NAME")
USER_GROUP=$(id -gn "$USER_NAME")

conf_load "$CONF"
trap conf_cleanup EXIT

# ---------------------------------------------------------------------------
# Extra SSH keys
# ---------------------------------------------------------------------------
EXTRA_KEYS=$(conf_get Install.RemoteAdmin.ExtraSSHKeys "")
if [ -n "$EXTRA_KEYS" ]; then
    AUTH="$HOME_DIR/.ssh/authorized_keys"
    install -d -m 0700 -o "$USER_NAME" -g "$USER_GROUP" "$HOME_DIR/.ssh"
    touch "$AUTH"
    printf '%s\n' "$EXTRA_KEYS" | while IFS= read -r key; do
        [ -n "$key" ] || continue
        grep -qxF "$key" "$AUTH" || { printf '%s\n' "$key" >> "$AUTH"; log "added an extra SSH key"; }
    done
    chown "$USER_NAME:$USER_GROUP" "$AUTH"
    chmod 0600 "$AUTH"

    # Only worth hardening sshd once we know a key can get in.
    install -d -m 0755 /etc/ssh/sshd_config.d
    cat > /etc/ssh/sshd_config.d/10-ogn.conf <<'EOF'
# Installed by ogn-bootstrap because SSH keys were supplied.
PasswordAuthentication no
KbdInteractiveAuthentication no
EOF
    systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# Raspberry Pi Connect
#
# rpi-connect runs as a *user* service, which means the account needs linger
# enabled or it stops the moment the operator logs out. Raspberry Pi's own
# documentation does not mention that; the sequence below is the one Raspberry
# Pi Imager itself generates, which is the authoritative example.
# ---------------------------------------------------------------------------
if conf_bool Install.RemoteAdmin.Connect; then
    log "enabling Raspberry Pi Connect for $USER_NAME"
    if ! command -v rpi-connect >/dev/null; then
        apt_install rpi-connect-lite
    fi

    UNIT_DIR="$HOME_DIR/.config/systemd/user"
    install -d -m 0755 -o "$USER_NAME" -g "$USER_GROUP" "$HOME_DIR/.config"
    install -d -m 0755 -o "$USER_NAME" -g "$USER_GROUP" "$HOME_DIR/.config/systemd"
    install -d -m 0755 -o "$USER_NAME" -g "$USER_GROUP" "$UNIT_DIR"
    install -d -m 0755 -o "$USER_NAME" -g "$USER_GROUP" "$UNIT_DIR/default.target.wants"
    install -d -m 0755 -o "$USER_NAME" -g "$USER_GROUP" "$UNIT_DIR/paths.target.wants"
    ln -sfn /usr/lib/systemd/user/rpi-connect.service        "$UNIT_DIR/default.target.wants/rpi-connect.service"
    ln -sfn /usr/lib/systemd/user/rpi-connect-signin.path    "$UNIT_DIR/paths.target.wants/rpi-connect-signin.path"
    chown -h "$USER_NAME:$USER_GROUP" "$UNIT_DIR/default.target.wants/rpi-connect.service" \
                                     "$UNIT_DIR/paths.target.wants/rpi-connect-signin.path"

    install -d -m 0755 /var/lib/systemd/linger
    loginctl enable-linger "$USER_NAME" 2>/dev/null || install -m 0644 /dev/null "/var/lib/systemd/linger/$USER_NAME"

    AUTH_KEY=$(conf_get Install.RemoteAdmin.ConnectAuthKey "")
    CONNECT_DIR="$HOME_DIR/.config/com.raspberrypi.connect"
    install -d -m 0700 -o "$USER_NAME" -g "$USER_GROUP" "$CONNECT_DIR"
    if [ -n "$AUTH_KEY" ]; then
        printf '%s\n' "$AUTH_KEY" > "$CONNECT_DIR/auth.key"
        chown "$USER_NAME:$USER_GROUP" "$CONNECT_DIR/auth.key"
        chmod 0600 "$CONNECT_DIR/auth.key"
        log "Connect auth key written; the device will link itself"
    fi

    systemctl --quiet --user --machine="$USER_NAME@.host" daemon-reload 2>/dev/null || true
    systemctl --quiet --user --machine="$USER_NAME@.host" start rpi-connect.service 2>/dev/null || true

    if [ -z "$AUTH_KEY" ]; then
        MOTD_FILE=/etc/motd.d/30-ogn-connect motd_set <<EOF

  Raspberry Pi Connect is installed but not yet linked to an account.
  Run this as $USER_NAME and follow the link it prints:

      rpi-connect signin

EOF
    else
        rm -f /etc/motd.d/30-ogn-connect
    fi
else
    rm -f /etc/motd.d/30-ogn-connect
fi

# ---------------------------------------------------------------------------
# OGN core team reverse tunnel
#
# Opt-in only. This asks autossh.glidernet.org which port to use, then holds a
# reverse tunnel so the OGN team can reach this receiver's SSH from outside.
# They must have accepted this machine's key first — see the README. Driven by
# a systemd timer rather than a cron entry, so its state and failures are
# visible in the usual place.
# ---------------------------------------------------------------------------
if conf_bool Install.RemoteAdmin.OGNTeam; then
    log "enabling the OGN core team reverse tunnel"
    apt_install autossh

    cat > /usr/local/sbin/ogn-team-tunnel <<'TUNEOF'
#!/bin/bash
# Hold a reverse SSH tunnel to the OGN core team's relay. Installed by
# ogn-bootstrap, and only when Install.RemoteAdmin.OGNTeam is true.
set -euo pipefail
RELAY_HOST="autossh.glidernet.org"
RELAY_USER="glidernet-assh"

pgrep -x autossh >/dev/null && exit 0

CALL=$(sed -n 's/^ *Call *= *"\([^"]*\)".*/\1/p' /boot/firmware/MyReceiver.conf 2>/dev/null | head -1)
[ -n "$CALL" ] || CALL=$(hostname -s)

IFACE=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
MAC=$(cat "/sys/class/net/${IFACE:-eth0}/address" 2>/dev/null || echo unknown)
VERSION=$(basename "$(readlink -f /home/*/rtlsdr-ogn 2>/dev/null | head -1)" 2>/dev/null || echo unknown)

PORT=$(curl --fail --silent --max-time 30 \
    "http://$RELAY_HOST/remoteReceiver/?r=$CALL&m=$MAC&i=$VERSION") || {
        echo "could not obtain a tunnel port from $RELAY_HOST" >&2; exit 1; }

case "$PORT" in ''|*[!0-9]*) echo "relay returned '$PORT', not a port" >&2; exit 1 ;; esac

exec autossh -M "${PORT}0" -N -f \
    -R "${PORT}:localhost:22" \
    -o "ServerAliveInterval 60" -o "ServerAliveCountMax 3" \
    -o "ExitOnForwardFailure yes" -o "StrictHostKeyChecking accept-new" \
    "$RELAY_USER@$RELAY_HOST"
TUNEOF
    chmod 0755 /usr/local/sbin/ogn-team-tunnel

    cat > /etc/systemd/system/ogn-team-tunnel.service <<'EOF'
[Unit]
Description=OGN core team reverse SSH tunnel
Documentation=https://github.com/glidernet/ogn-bootstrap
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStart=/usr/local/sbin/ogn-team-tunnel
EOF
    cat > /etc/systemd/system/ogn-team-tunnel.timer <<'EOF'
[Unit]
Description=Keep the OGN core team reverse tunnel up

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min

[Install]
WantedBy=timers.target
EOF
    systemctl daemon-reload
    systemctl enable --now ogn-team-tunnel.timer >/dev/null
else
    systemctl disable --now ogn-team-tunnel.timer >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/ogn-team-tunnel.timer \
          /etc/systemd/system/ogn-team-tunnel.service \
          /usr/local/sbin/ogn-team-tunnel
fi
OGN_PAYLOAD_ogn_remote_admin
chmod 0755 /usr/local/sbin/ogn-remote-admin

cat > /usr/local/sbin/ogn-calibrate <<'OGN_PAYLOAD_ogn_calibrate'
#!/bin/bash
#
# ogn-calibrate — measure the SDR's crystal error in ppm using gsm_scan.
#
#   sudo ogn-calibrate                measure and report
#   sudo ogn-calibrate --quiet        print just the number, for scripting
#   sudo ogn-calibrate --apply        measure and write FreqCorr into the config
#   sudo ogn-calibrate --from-config  do nothing unless the card asked for it
#
# gsm_scan listens to GSM base stations, whose carriers are far tighter than
# any TV dongle, and reports the crystal error and which channel it heard.
# Both are recorded: ogn-rf re-reads RF.GSM.CenterFreq while it decodes and
# tracks the drift from there, so the channel is the durable half.
#
# Needs the aerial and GSM coverage. Rural sites, filtered masthead amplifiers
# and TCXO sticks may simply find nothing, which is fine.
#
# It takes the SDR, so the receiver is stopped and restarted around it.
#
# --from-config is the unattended route, off unless the card sets
# RF.Calibrate = true. It writes the results back to MyReceiver.conf on the
# card and clears Calibrate, so a request runs once. Writing to the card is the
# point: the journal is in RAM and the Pi is headless.
#
# Copyright (c) 2026 ifly7charlie. MIT licence, see LICENSE.

set -euo pipefail

LIBDIR="${OGN_LIBDIR:-/usr/local/lib/ogn-bootstrap}"
# shellcheck source=src/ogn-common.sh
. "$LIBDIR/ogn-common.sh"

QUIET=0
APPLY=0
FROM_CONFIG=0
SCAN_TIMEOUT="${OGN_CALIBRATE_TIMEOUT:-180}"
while [ $# -gt 0 ]; do
    case "$1" in
        --quiet)       QUIET=1; shift ;;
        --apply)       APPLY=1; shift ;;
        --from-config) FROM_CONFIG=1; shift ;;
        -h|--help)     sed -n '3,26p' "$0"; exit 0 ;;
        *)             die "unknown option: $1" ;;
    esac
done

need_root

# Checked on every boot; the answer is almost always no.
if [ "$FROM_CONFIG" -eq 1 ]; then
    [ -r "$BOOT_CONF" ] || exit 0
    conf_load "$BOOT_CONF"
    conf_bool RF.Calibrate false || exit 0
    APPLY=1
    QUIET=0
fi
OGN_USER=$(detect_ogn_user) || die "could not determine the user"
INSTALL_DIR=$(readlink -f "$(user_home "$OGN_USER")/rtlsdr-ogn" 2>/dev/null) \
    || die "the OGN software is not installed yet"
[ -x "$INSTALL_DIR/gsm_scan" ] || die "no gsm_scan in $INSTALL_DIR"

TMP=$(mktemp -d)

# gsm_scan and ogn-rf both open the SDR. Put the receiver back however this
# ends: timeout, failed scan or Ctrl-C.
RESTART_RECEIVER=0
restore_receiver() {
    [ "$RESTART_RECEIVER" -eq 1 ] || return 0
    systemctl start rtlsdr-ogn.service >/dev/null 2>&1 || true
}
trap 'rm -rf "$TMP"; restore_receiver' EXIT

# card_writeback <ppm> <freq> <gain> <note>
#
# Record the results on the card and clear Calibrate. Empty ppm means the scan
# found nothing: disarm anyway, with the reason, or a site with no GSM repeats
# a three-minute scan at every boot.
card_writeback() {
    local ppm="$1" freq="$2" gain="$3" note="$4" stamp tmp
    stamp=$(date -I)
    tmp="$TMP/MyReceiver.conf"
    cp "$BOOT_CONF" "$tmp" 2>/dev/null || { warn "could not read $BOOT_CONF"; return 1; }

    if [ -n "$ppm" ]; then
        conf_set_value "$tmp" FreqCorr   "$ppm"  "measured $stamp"     || warn "no FreqCorr line to set"
        conf_set_value "$tmp" CenterFreq "$freq" "measured $stamp" GSM || warn "no GSM CenterFreq line to set"
        conf_set_value "$tmp" Gain       "$gain" "measured $stamp" GSM || warn "no GSM Gain line to set"
    fi

    # Refuse rather than loop: no Calibrate line means no way to disarm.
    if ! conf_set_value "$tmp" Calibrate false "$stamp: $note"; then
        warn "no Calibrate line in $BOOT_CONF to switch off; nothing written back"
        return 1
    fi

    if boot_replace "$BOOT_CONF" < "$tmp"; then
        log "wrote the result back to $BOOT_CONF"
        return 0
    fi
    warn "could not write to $BOOT_CONF — is the card write-protected?"
    warn "Calibrate is still true there, so this will run again at the next boot"
    return 1
}

if systemctl is-active --quiet rtlsdr-ogn.service 2>/dev/null; then
    RESTART_RECEIVER=1
    [ "$QUIET" -eq 1 ] || log "stopping the receiver while the scan runs"
    systemctl stop rtlsdr-ogn.service >/dev/null 2>&1 || true
fi
# GSM-900 downlink by default; 915 MHz sites are in GSM-850 territory.
BAND_OPT=""
if awk "BEGIN{exit !($(conf_get RF.OGN.CenterFreq 868.8) > 900)}" 2>/dev/null; then
    BAND_OPT="--gsm-850"
fi

# gsm_scan defaults to device 0, which on a two-dongle receiver may be the
# ADS-B stick — and the result is written back as though it were right. Follow
# the same selection ogn-rf uses: DeviceSerial wins where set.
DEV_SERIAL=$(conf_get RF.DeviceSerial "")
if [ -n "$DEV_SERIAL" ]; then
    DEV_OPT="--serial $DEV_SERIAL"
    DEV_DESC="serial $DEV_SERIAL"
else
    DEV_OPT="--device $(conf_get RF.Device 0)"
    DEV_DESC="device $(conf_get RF.Device 0)"
fi

# --ppm 0 deliberately, not a previous measurement: a stale estimate pulls the
# scan off, and 0 is what a low-drift stick actually is.
SCAN_GAIN=$(conf_get RF.GSM.Gain 25.0)

[ "$QUIET" -eq 1 ] || log "scanning for GSM carriers on $DEV_DESC (up to ${SCAN_TIMEOUT}s) — this needs the aerial connected"

# shellcheck disable=SC2086
OUT=$(cd "$INSTALL_DIR" && timeout "$SCAN_TIMEOUT" \
      ./gsm_scan --ppm 0 --gain "$SCAN_GAIN" $DEV_OPT $BAND_OPT 2>&1) || true

# Too little or too much gain is gsm_scan's usual first answer. One pass cannot
# fix that, so name the knob that can.
GAIN_HINT=""
case "$OUT" in
    *"retry with higher gain"*)
        GAIN_HINT="; raise RF.GSM.Gain above $SCAN_GAIN and try again" ;;
    *"lower gain to reduce distortions"*)
        GAIN_HINT="; lower RF.GSM.Gain below $SCAN_GAIN and try again" ;;
esac

# Match on the phrase, not a field position, so spacing changes cannot yield a
# wrong correction.
PPM=$(printf '%s\n' "$OUT" \
      | sed -n 's/.*[Xx]tal correction[^0-9+-]*\([+-]\?[0-9]\+\(\.[0-9]\+\)\?\).*/\1/p' \
      | head -1)

# Channel lines read roughly  938.6MHz ... +42.3dB: -0.4 -0.2 +0.1 ...
# Score strength minus twice the mean absolute offset, drop anything drifting
# by 4 or more. ogn-rf keeps using this channel to track the crystal, so a loud
# but unsteady one is worse than none. Weighting is from the v2.1 configure.
BEST=$(printf '%s\n' "$OUT" | awk '
    /MHz.*dB:/ {
        if (match($0, /[0-9]+\.?[0-9]*MHz/)) {
            freq = substr($0, RSTART, RLENGTH - 3)
        } else next
        if (match($0, /\+[0-9]+\.?[0-9]*dB/)) {
            strength = substr($0, RSTART + 1, RLENGTH - 3) + 0
        } else next
        tail = substr($0, index($0, "dB:") + 3)
        n = split(tail, off, /[ \t]+/)
        sum = 0; count = 0
        for (i = 1; i <= n; i++) {
            if (off[i] ~ /^[+-]?[0-9]+\.?[0-9]*$/) {
                v = off[i] + 0
                sum += (v < 0 ? -v : v)
                count++
            }
        }
        if (count == 0) next
        mean = sum / count
        if (mean >= 4) next
        score = strength - 2 * mean
        if (score > best_score || best_freq == "") { best_score = score; best_freq = freq }
    }
    END { if (best_freq != "") print best_freq }
')

if [ -z "$PPM" ] || [ -z "$BEST" ]; then
    [ "$QUIET" -eq 1 ] || warn "no usable GSM signal found${GAIN_HINT}"
    [ "$FROM_CONFIG" -eq 1 ] && card_writeback "" "" "" "no usable GSM signal found${GAIN_HINT}"
    exit 1
fi

PPM=${PPM%.*}   # the config wants an integer

if [ "$QUIET" -eq 1 ]; then
    printf '%s\n' "$PPM"
    exit 0
fi

log "measured frequency correction: ${PPM} ppm on the ${BEST} MHz GSM channel"

if [ "$APPLY" -eq 1 ]; then
    CONF="$INSTALL_DIR/MyReceiver.conf"
    [ -f "$CONF" ] || die "no $CONF to update"
    conf_set_value "$CONF" FreqCorr   "$PPM"      "measured by ogn-calibrate"
    conf_set_value "$CONF" CenterFreq "$BEST"     "measured by ogn-calibrate" GSM
    conf_set_value "$CONF" Gain       "$SCAN_GAIN" "measured by ogn-calibrate" GSM
    log "wrote the scan results to $CONF"
fi

if [ "$FROM_CONFIG" -eq 1 ]; then
    card_writeback "$PPM" "$BEST" "$SCAN_GAIN" \
        "${PPM} ppm on ${BEST} MHz at gain ${SCAN_GAIN}" || true
fi
OGN_PAYLOAD_ogn_calibrate
chmod 0755 /usr/local/sbin/ogn-calibrate

cat > /usr/local/sbin/ogn-overlay <<'OGN_PAYLOAD_ogn_overlay'
#!/bin/bash
#
# ogn-overlay — turn the read-only root filesystem on and off by hand.
#
#   overlay status           what is on now, and after a reboot
#   overlay off              come up writable at the next boot
#   overlay on               go back to protected at the next boot
#   overlay off --reboot     ... and reboot now
#   overlay on  --reboot
#
# Also installed as `overlay`. For maintenance the weekly window does not
# cover: with the overlay on, changes are discarded at the next boot.
#
#   sudo overlay off --reboot     # comes back writable
#   ... do the work ...
#   sudo overlay on --reboot      # back to protected
#
# Switching always takes effect at the next boot: the overlay is established by
# the initramfs, before the root filesystem is mounted.
#
# Copyright (c) 2026 ifly7charlie. MIT licence, see LICENSE.

set -euo pipefail

LIBDIR="${OGN_LIBDIR:-/usr/local/lib/ogn-bootstrap}"
# shellcheck source=src/ogn-common.sh
. "$LIBDIR/ogn-common.sh"

REBOOT=0
ACTION=""
while [ $# -gt 0 ]; do
    case "$1" in
        on|enable)    ACTION=on ;;
        off|disable)  ACTION=off ;;
        status)       ACTION=status ;;
        --reboot)     REBOOT=1 ;;
        -h|--help)    sed -n '3,19p' "$0"; exit 0 ;;
        *)            die "unknown argument: $1  (try: overlay status)" ;;
    esac
    shift
done

# --------------------------------------------------------------------------
# status — readable by anyone, so a check does not need sudo
# --------------------------------------------------------------------------
if [ "$ACTION" = status ] || [ -z "$ACTION" ]; then
    if overlay_active; then
        printf 'now:        ACTIVE — the root filesystem is read-only.\n'
        printf '            Changes you make are discarded at the next reboot.\n'
    else
        printf 'now:        inactive — the root filesystem is writable.\n'
        printf '            Changes you make persist, and are written to the SD card.\n'
    fi
    # cmdline.txt holds the answer and the boot partition is root-only, so for
    # anyone else it comes from the copy published at boot. If that is missing
    # too, say so: "inactive" would be a guess, and the wrong one is the one
    # that reads as reassuring.
    if ! overlay_next_boot_known; then
        printf 'next boot:  unknown — cannot read %s,\n' "$CMDLINE_FILE"
        printf '            and no published copy at %s\n' "$OVERLAY_STATE"
        printf '\nFor a definite answer:  sudo overlay status\n'
        exit 0
    fi
    if overlay_next_boot; then
        printf 'next boot:  ACTIVE\n'
    else
        printf 'next boot:  inactive\n'
    fi
    if overlay_active && ! overlay_next_boot; then
        printf '\nA reboot will leave this receiver WRITABLE and unprotected.\n'
        printf 'Run "sudo overlay on" to undo that.\n'
    elif ! overlay_active && overlay_next_boot; then
        printf '\nA reboot will make it read-only.\n'
    fi
    [ -z "$ACTION" ] && printf '\nTo change it:  sudo overlay off   |   sudo overlay on\n'
    exit 0
fi

need_root

# --------------------------------------------------------------------------
# off — writable at the next boot
# --------------------------------------------------------------------------
if [ "$ACTION" = off ]; then
    if ! overlay_next_boot; then
        log "the overlay is already disabled for the next boot"
    else
        cmdline_write "$OVERLAY_PARAM" 0 || die "could not update $CMDLINE_FILE"
        log "overlay disabled — the next boot will come up writable"
    fi

    overlay_motd_update

    if overlay_active; then
        warn "still read-only until you reboot"
    fi
    if [ "$REBOOT" -eq 1 ]; then
        log "rebooting"
        systemctl reboot
    else
        log "reboot when ready:  sudo reboot"
    fi
    exit 0
fi

# --------------------------------------------------------------------------
# on — protected at the next boot
# --------------------------------------------------------------------------
overlay_ensure_initramfs || die "could not arrange for an initramfs to be loaded"

if ! overlay_preflight; then
    die "the overlay cannot be enabled safely yet — see the warnings above.
     Fix those first: an overlayroot=tmpfs with nothing to act on boots
     normally and keeps writing to the card, with nothing to tell you so."
fi

swap_disable

if overlay_next_boot; then
    log "the overlay is already enabled for the next boot"
else
    cmdline_write "$OVERLAY_PARAM" 1 || die "could not update $CMDLINE_FILE"
    log "overlay enabled — the next boot will come up read-only"
fi

overlay_motd_update

if ! overlay_active; then
    warn "still writable until you reboot"
fi
if [ "$REBOOT" -eq 1 ]; then
    log "rebooting"
    systemctl reboot
else
    log "reboot when ready:  sudo reboot"
fi
OGN_PAYLOAD_ogn_overlay
chmod 0755 /usr/local/sbin/ogn-overlay

cat > /usr/local/sbin/ogn-wireguard <<'OGN_PAYLOAD_ogn_wireguard'
#!/bin/bash
#
# ogn-wireguard — bring the Network.WireGuard tunnel up, down, or into step
# with whatever the card now says.
#
#   sudo ogn-wireguard            apply Network.WireGuard from the card
#   sudo ogn-wireguard status     is it up, and is it talking to the server
#   sudo ogn-wireguard down       take it down until the next boot
#   sudo ogn-wireguard --config X use a different config file
#
# Run at every boot by ogn-wireguard.service, once the network is up, and
# every 10 minutes after that by ogn-wireguard.timer — which is what puts the
# tunnel back when the server moves to a new address, the case a tunnel for
# remote administration is least able to tell you about.
#
# Copyright (c) 2026 ifly7charlie. MIT licence, see LICENSE.

set -euo pipefail

LIBDIR="${OGN_LIBDIR:-/usr/local/lib/ogn-bootstrap}"
# shellcheck source=src/ogn-common.sh
. "$LIBDIR/ogn-common.sh"

ACTION=apply
while [ $# -gt 0 ]; do
    case "$1" in
        apply|--apply)   ACTION=apply ;;
        down|--down)     ACTION=down ;;
        status|--status) ACTION=status ;;
        --config)        BOOT_CONF="$2"; shift ;;
        -h|--help)       sed -n '3,15p' "$0"; exit 0 ;;
        *)               die "unknown argument: $1  (try: ogn-wireguard status)" ;;
    esac
    shift
done

need_root

# --------------------------------------------------------------------------
# status
# --------------------------------------------------------------------------
if [ "$ACTION" = status ]; then
    conf_load "$BOOT_CONF"
    trap conf_cleanup EXIT
    if ! conf_bool Network.WireGuard.Enable false; then
        printf 'WireGuard is switched off in %s.\n' "$BOOT_CONF"
        wg_up && printf 'The %s interface is still up; it goes at the next boot.\n' "$WG_IFACE"
        exit 0
    fi
    printf 'configured:  %s on %s, through %s\n' \
        "$(conf_get Network.WireGuard.Address '<unset>')" "$WG_IFACE" \
        "$(conf_get Network.WireGuard.Peer.Endpoint '<unset>')"
    if ! wg_up; then
        printf 'interface:   DOWN\n\n'
        printf 'Bring it up with:  sudo ogn-wireguard\n'
        printf 'Why it is down:    journalctl -u ogn-wireguard\n'
        exit 1
    fi
    printf 'interface:   up\n\n'
    wg show "$WG_IFACE"
    # A tunnel with no handshake looks exactly like a working one from here,
    # so spell out the difference rather than leaving it to be read off.
    HS=$(wg show "$WG_IFACE" latest-handshakes | awk 'NR == 1 { print $2 }')
    case "$HS" in
        ''|0) printf '\nNo handshake yet: the server has not answered. Check its [Peer]\n'
              printf 'has this receiver'"'"'s public key, and that %s is reachable.\n' \
                  "$(conf_get Network.WireGuard.Peer.Endpoint '')" ;;
        *)    printf '\nLast handshake %ss ago.\n' "$(( $(date +%s) - HS ))" ;;
    esac
    exit 0
fi

# --------------------------------------------------------------------------
# down — by hand, for the length of this boot
# --------------------------------------------------------------------------
if [ "$ACTION" = down ]; then
    conf_load "$BOOT_CONF"
    trap conf_cleanup EXIT
    wireguard_down
    conf_bool Network.WireGuard.Enable false \
        && log "still enabled on the card, so it comes back at the next boot"
    exit 0
fi

# --------------------------------------------------------------------------
# apply
# --------------------------------------------------------------------------
[ -r "$BOOT_CONF" ] || { log "no $BOOT_CONF on the card; nothing to do"; exit 0; }
conf_load "$BOOT_CONF"
trap conf_cleanup EXIT

# The timer is the repair loop, and it is worth having only on a receiver that
# is actually using a tunnel. Enabling it from here rather than from the
# installer is what lets WireGuard be switched on by editing the card alone,
# with no re-install and no network.
if conf_bool Network.WireGuard.Enable false; then
    systemctl is-enabled --quiet ogn-wireguard.timer 2>/dev/null \
        || systemctl enable --now ogn-wireguard.timer >/dev/null 2>&1 || true
else
    systemctl is-enabled --quiet ogn-wireguard.timer 2>/dev/null \
        && systemctl disable --now ogn-wireguard.timer >/dev/null 2>&1 || true
fi

wireguard_apply
OGN_PAYLOAD_ogn_wireguard
chmod 0755 /usr/local/sbin/ogn-wireguard

cat > /usr/local/sbin/ogn-adsb <<'OGN_PAYLOAD_ogn_adsb'
#!/bin/bash
#
# ogn-adsb — bring ADS-B reception up, down, or into step with whatever the
# card now says.
#
#   sudo ogn-adsb              apply ADSB from the card
#   sudo ogn-adsb status       is readsb running, and is it hearing aircraft
#   sudo ogn-adsb down         switch it off until the next boot
#   sudo ogn-adsb --config X   use a different config file
#
# Run at every boot by ogn-adsb.service, and every 10 minutes after that by
# ogn-adsb.timer — which is what puts a feed back when a tracking site moves
# to a new address, or when the ADS-B stick is unplugged and returned.
#
