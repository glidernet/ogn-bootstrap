UNCOMMENT
conf_load "$ADU/c.conf"
conf_bool ADSB.Enable false && ok "uncommenting the shipped block switches it on"                             || bad "uncommenting the shipped block switches it on"
is "and names the 1090 stick"        "$(conf_get ADSB.DeviceSerial)"             "1090"
is "and hands the decoder the feed"  "$(conf_get ADSB.AVR)"                      "localhost:30002"
ADUR=$(adsb_render 2>/dev/null) && ok "and renders a usable readsb config"                                 || bad "and renders a usable readsb config"
# Every site ships false, so switching ADS-B on must not, by itself, start
# sending what this receiver hears to anybody new.
case "$ADUR" in
    *net-connector*) bad "and shares it with nobody until asked" "$ADUR" ;;
    *)               ok  "and shares it with nobody until asked" ;;
esac
rm -rf "$ADU"
conf_load boot/MyReceiver.conf

# A filled-in card. The identity source is pinned, so the UUID is known.
ADID=$(mktemp -d)
printf '100000001234abcd\0' > "$ADID/serial-number"
ADSB_ID_SOURCES="$ADID/serial-number"
conf_load tests/fixtures/adsb.conf
AD=$(adsb_render 2>/dev/null) || bad "the fixture renders"
for expect in \
    '--device 1090' \
    '--device-type rtlsdr' \
    '--gain -10' \
    "--net-ro-port 30002" \
    "--net-bo-port 30005" \
    "--net-bi-port 30104" \
    '--net-connector feed.adsb.fi,30004,beast_reduce_plus_out' \
    '--net-connector feed.airplanes.live,30004,beast_reduce_plus_out' \
    'JSON_OPTIONS=""'
do
    case "$AD" in
        *"$expect"*) ok "renders $expect" ;;
        *)           bad "renders $expect" "$AD" ;;
    esac
done
# A site that was not ticked must not appear. This is the assertion that says
# "off" means "no connection", not "a connection nobody looked at".
case "$AD" in
    *adsbexchange*) bad "a site left off is not fed" "$AD" ;;
    *)              ok  "a site left off is not fed" ;;
esac
# No --write-json, ever: there is no map on this image, and the directory
# would be rewritten every second onto a card the overlay exists to protect.
case "$AD" in
    *write-json*) bad "nothing is written to disk continuously" "$AD" ;;
    *)            ok  "nothing is written to disk continuously" ;;
esac
is "the summary names who gets it" "$(adsb_feed_summary)" "OGN, feed.adsb.fi, feed.airplanes.live"

# The feed sites are told who is sending, or readsb logs "Not a valid UUID"
# on every connection and the feed arrives anonymously.
ADU1=$(adsb_uuid)
adsb_uuid_ok "$ADU1" && ok "a UUID is derived from the hardware serial" || bad "a UUID is derived from the hardware serial" "$ADU1"
case "$AD" in
    *"--uuid $ADU1"*) ok  "and readsb is given it" ;;
    *)                bad "and readsb is given it" "$AD" ;;
esac
is "the same serial gives the same UUID" "$(adsb_uuid)" "$ADU1"
case "$ADU1" in *1234abcd*) bad "the serial itself is not sent" "$ADU1" ;; *) ok "the serial itself is not sent" ;; esac
printf 'Serial\t\t: 100000001234abcd\n' > "$ADID/cpuinfo"
is "cpuinfo gives the same answer as the device tree" \
   "$(ADSB_ID_SOURCES="$ADID/missing $ADID/cpuinfo"; adsb_uuid)" "$ADU1"
printf 'Serial\t\t: 0000000000000000\n' > "$ADID/zero"
printf 'abcdef0123456789abcdef0123456789\n' > "$ADID/machine-id"
ADU2=$(ADSB_ID_SOURCES="$ADID/zero $ADID/machine-id"; adsb_uuid)
adsb_uuid_ok "$ADU2" && [ "$ADU2" != "$ADU1" ] \
    && ok "an all-zero serial falls through to machine-id" || bad "an all-zero serial falls through to machine-id" "$ADU2"
ADN=$(ADSB_ID_SOURCES="$ADID/missing"; adsb_render 2>/dev/null)
case "$ADN" in
    *--uuid*)          bad "with no identity at all it feeds anonymously" "$ADN" ;;
    *net-connector*)   ok  "with no identity at all it feeds anonymously" ;;
    *)                 bad "with no identity at all it feeds anonymously" "$ADN" ;;
esac

# One multilateration environment per site that is on, and none for the rest.
ML=$(adsb_mlat_render ADSBFi 2>/dev/null) || bad "an mlat environment renders"
case "$ML" in
    *"MLAT_SERVER=feed.adsb.fi:31090"*) ok "mlat points at the right server" ;;
    *) bad "mlat points at the right server" "$ML" ;;
esac
case "$ML" in
    *"MLAT_RESULTS=beast,connect,localhost:30104"*) ok "mlat results come back to readsb" ;;
    *) bad "mlat results come back to readsb" "$ML" ;;
esac
is "mlat instance names are lowercase" "$(adsb_feed_instance ADSBFi)" "adsbfi"

# Required fields, one at a time.
ADT=$(mktemp -d)
sed 's/^  DeviceSerial = "1090";/  DeviceSerial = "";/' tests/fixtures/adsb.conf > "$ADT/c.conf"
conf_load "$ADT/c.conf"
adsb_render >/dev/null 2>&1 \
    && bad "an empty ADSB.DeviceSerial is refused" \
    || ok  "an empty ADSB.DeviceSerial is refused"
# Gain is different, and deliberately so: conf_get cannot tell an empty value
# from an absent one, so a blank Gain falls back to the -10 that means "let the
# tuner decide". That is the right answer for a gain, and the wrong one for a
# serial, which is why only the serial is required above.
sed 's/^  Gain         = -10;/  Gain = "";/' tests/fixtures/adsb.conf > "$ADT/c.conf"
conf_load "$ADT/c.conf"
# Captured rather than piped into grep -q: grep exits at the first match and
# the SIGPIPE that follows becomes a pipeline failure under pipefail.
ADG=$(adsb_render 2>/dev/null)
case "$ADG" in
    *"--gain -10"*) ok  "an empty ADSB.Gain falls back to automatic" ;;
    *)              bad "an empty ADSB.Gain falls back to automatic" "$ADG" ;;
esac
# The trap the whole two-dongle section exists to avoid: RF.Device is an index
# and indexes move, so ADS-B without RF.DeviceSerial can hand the OGN decoder
# the 1090 stick and leave nothing to explain the silence.
sed 's/^  DeviceSerial = "868";//' tests/fixtures/adsb.conf > "$ADT/c.conf"
conf_load "$ADT/c.conf"
adsb_render >/dev/null 2>&1 \
    && bad "ADS-B without RF.DeviceSerial is refused" \
    || ok  "ADS-B without RF.DeviceSerial is refused"

check_rejects() {
    sed "$2" tests/fixtures/adsb.conf > "$ADT/c.conf"
    conf_load "$ADT/c.conf"
    adsb_render >/dev/null 2>&1 && bad "$1" || ok "$1"
}
check_rejects "both sticks given the same serial is refused" 's/DeviceSerial = "1090"/DeviceSerial = "868"/'
check_rejects "a non-numeric gain is refused"                's/Gain         = -10/Gain         = "loud"/'
check_rejects "a Custom entry with no port is refused"       's|Custom        = ""|Custom = "feed.example.org"|'
# Multilateration compares arrival times between receivers, so a receiver that
# is not where it says it is makes everyone else's answers worse.
check_rejects "mlat with the position still 0,0 is refused"  's/Latitude  = +51.1874/Latitude = 0.0/; s/Longitude =  -1.8340/Longitude = 0.0/'
check_rejects "mlat with no site to send it to is refused"   's/ADSBFi        = true/ADSBFi = false/; s/AirplanesLive = true/AirplanesLive = false/'
check_rejects "an ADSB.Feed.UUID that is not a UUID is refused" 's|Custom        = ""|Custom = ""; UUID = "not-a-uuid"|'
sed 's|Custom        = ""|Custom = ""; UUID = "01234567-89ab-cdef-0123-456789abcdef"|' tests/fixtures/adsb.conf > "$ADT/c.conf"
conf_load "$ADT/c.conf"
ADO=$(adsb_render 2>/dev/null)
case "$ADO" in
    *"--uuid 01234567-89ab-cdef-0123-456789abcdef"*) ok  "ADSB.Feed.UUID on the card wins" ;;
    *)                                               bad "ADSB.Feed.UUID on the card wins" "$ADO" ;;
esac
# A custom target that IS well formed has to survive all of that.
sed 's|Custom        = ""|Custom = "feed.example.org:30004"|' tests/fixtures/adsb.conf > "$ADT/c.conf"
conf_load "$ADT/c.conf"
ADC=$(adsb_render 2>/dev/null)
case "$ADC" in
    *"feed.example.org,30004,beast_reduce_plus_out"*) ok  "a well-formed Custom target is fed" ;;
    *)                                                bad "a well-formed Custom target is fed" "$ADC" ;;
esac
rm -rf "$ADT" "$ADID"

# The whole apply path, against stubs. systemctl is what must not be called
# twice, and readsb only has to exist for the command -v check.
STUB=$(mktemp -d)
export ADSB_LOG="$STUB/calls"
: > "$ADSB_LOG"; : > "$ADSB_LOG.on"
printf '#!/bin/bash\nexit 0\n' > "$STUB/readsb"
cat > "$STUB/systemctl" <<'STUBEOF'
#!/bin/bash
printf 'systemctl %s\n' "$*" >> "$ADSB_LOG"
verb="$1"; shift
unit=""
for a in "$@"; do case "$a" in --*) ;; *) unit="$a" ;; esac; done
case "$verb" in
    is-active|is-enabled) grep -qx "$unit" "$ADSB_LOG.on" 2>/dev/null ;;
    enable|start|restart) printf '%s\n' "$unit" >> "$ADSB_LOG.on"; exit 0 ;;
    disable)              case " $* " in *" --now "*) ;; *) exit 0 ;; esac
                          grep -vx "$unit" "$ADSB_LOG.on" > "$ADSB_LOG.on.t" 2>/dev/null
                          mv "$ADSB_LOG.on.t" "$ADSB_LOG.on" 2>/dev/null; exit 0 ;;
    stop)                 grep -vx "$unit" "$ADSB_LOG.on" > "$ADSB_LOG.on.t" 2>/dev/null
                          mv "$ADSB_LOG.on.t" "$ADSB_LOG.on" 2>/dev/null; exit 0 ;;
    *) exit 0 ;;
esac
STUBEOF
chmod +x "$STUB/readsb" "$STUB/systemctl"
OLD_PATH="$PATH"; PATH="$STUB:$PATH"
OLD_DEFAULT="$ADSB_DEFAULT"; OLD_MLAT="$ADSB_MLAT_DIR"; OLD_AMOTD="$ADSB_MOTD"
ADSB_DEFAULT="$STUB/default-readsb"; ADSB_MLAT_DIR="$STUB/mlat"; ADSB_MOTD="$STUB/motd"

conf_load tests/fixtures/adsb.conf
adsb_apply >/dev/null 2>&1 && ok "applies cleanly" || bad "applies cleanly"
[ -f "$ADSB_DEFAULT" ] && ok "writes the readsb defaults" || bad "writes the readsb defaults"
grep -q 'systemctl restart readsb' "$ADSB_LOG" && ok "starts readsb" || bad "starts readsb"
# Enabled, readsb starts at boot before the card is read, and an enable made
# while the root is writable outlives the overlay. ogn-adsb.service starts it.
grep -q 'systemctl enable readsb' "$ADSB_LOG" \
    && bad "readsb is started, never enabled" || ok "readsb is started, never enabled"
# The mlat units wait for network-online.target; the config resync runs before
# it. A blocking restart from there is a boot that never finishes.
if grep 'ogn-mlat@' "$ADSB_LOG" | grep -E ' (restart|enable) ' | grep -vq -- '--no-block'; then
    bad "mlat clients are started without waiting on them" "$(cat "$ADSB_LOG")"
else
    ok "mlat clients are started without waiting on them"
fi
[ -f "$ADSB_MLAT_DIR/adsbfi.env" ] \
    && ok "an mlat environment for each site that is on" \
    || bad "an mlat environment for each site that is on"
[ -f "$ADSB_MLAT_DIR/adsblol.env" ] \
    && bad "and none for a site that is off" \
    || ok  "and none for a site that is off"
# The mlat environment is in /run, not /var/lib: it is a rendering of the card,
# and must not survive a reboot into disagreeing with it.
grep -q '/run/ogn-bootstrap/mlat' src/ogn-common.sh \
    && ok "mlat settings live in /run" || bad "mlat settings live in /run"

# Idempotence. A boot-time re-apply that bounces a working feed would drop
# every aircraft it is tracking for no reason.
: > "$ADSB_LOG"
adsb_apply >/dev/null 2>&1 && ok "a second apply is clean" || bad "a second apply is clean"
grep -q 'restart readsb' "$ADSB_LOG" \
    && bad "an unchanged, working feed is left alone" \
    || ok  "an unchanged, working feed is left alone"

# A changed setting must not be left alone.
sed 's/ADSBLol       = false/ADSBLol = true/' tests/fixtures/adsb.conf > "$STUB/c.conf"
conf_load "$STUB/c.conf"
: > "$ADSB_LOG"
adsb_apply >/dev/null 2>&1
grep -q 'restart readsb' "$ADSB_LOG" \
    && ok "adding a site restarts the decoder" || bad "adding a site restarts the decoder"
[ -f "$ADSB_MLAT_DIR/adsblol.env" ] \
    && ok "and brings its mlat client with it" || bad "and brings its mlat client with it"

# Switched off on the card: stopped, and the rendering removed with it.
sed 's/Enable       = true/Enable = false/' tests/fixtures/adsb.conf > "$STUB/c.conf"
conf_load "$STUB/c.conf"
adsb_apply >/dev/null 2>&1 && ok "switching it off on the card applies cleanly" \
                           || bad "switching it off on the card applies cleanly"
[ -f "$ADSB_DEFAULT" ] && bad "and the readsb defaults are removed" \
                       || ok  "and the readsb defaults are removed"
[ -f "$ADSB_MLAT_DIR/adsbfi.env" ] && bad "and every mlat client with them" \
                                   || ok  "and every mlat client with them"

PATH="$OLD_PATH"
ADSB_DEFAULT="$OLD_DEFAULT"; ADSB_MLAT_DIR="$OLD_MLAT"; ADSB_MOTD="$OLD_AMOTD"
rm -rf "$STUB"; unset ADSB_LOG

echo "== ADS-B plumbing =="
grep -q 'ogn-adsb' boot/vendor-data && ok "vendor-data carries ogn-adsb" || bad "vendor-data carries ogn-adsb"
grep -q 'src/ogn-adsb' tools/build-image.sh && ok "and so does the image build" || bad "and so does the image build"
grep -q 'src/ogn-adsb' tools/build-vendor-data \
    && ok "and the payload generator knows about it" \
    || bad "and the payload generator knows about it"
# Shipped in the image for the same reason as wireguard-tools: ADSB is outside
# the Install section, so a dongle added later never comes back through apt.
for pkg in readsb mlat-client-adsbfi; do
    grep -q "$pkg" tools/build-image.sh \
        && ok "the image ships $pkg, so the card alone can switch it on" \
        || bad "the image ships $pkg, so the card alone can switch it on"
done
# Everything comes from Debian. A third-party apt source in this file would
# make the promise at the top of build-image.yml false.
code_of tools/build-image.sh src/ogn-install src/ogn-adsb src/ogn-common.sh \
    | grep -qE 'sources\.list|apt-key|add-apt-repository|deb https?:' \
    && bad "ADS-B adds no third-party apt source" \
    || ok  "ADS-B adds no third-party apt source"
grep -q 'systemctl enable ogn-adsb.service' src/ogn-install \
    && ok "the service is enabled whatever the card says today" \
    || bad "the service is enabled whatever the card says today"
python3 - <<'PY' && ok "the ADS-B unit is independent of the OGN group" || bad "the ADS-B unit is independent of the OGN group"
import re
src = open("src/ogn-install").read()
unit = src.split("write_unit ogn-adsb.service <<'EOF'", 1)[1].split("\nEOF", 1)[0]
# ogn-calibrate stops rtlsdr-ogn to take the OGN stick for a GSM scan. ADS-B is
# on the other stick and has no business going down with it.
assert "PartOf" not in unit, "PartOf would stop ADS-B during a calibration run"
assert re.search(r"^Wants=network-online\.target", unit, re.M), "missing Wants=network-online.target"
assert "RemainAfterExit" not in unit, "RemainAfterExit stops the timer re-running it"
mlat = src.split("write_unit ogn-mlat@.service <<'EOF'", 1)[1].split("\nEOF", 1)[0]
assert "StandardOutput=journal" in mlat, "mlat must log to the journal, not /var/log"
PY
grep -q 'ogn-adsb.timer' src/ogn-adsb \
    && ok "the repair timer follows the card, not the installer" \
    || bad "the repair timer follows the card, not the installer"
grep -q 'ogn-adsb' src/ogn-maintenance \
    && ok "a live edit is picked up by the config resync" \
    || bad "a live edit is picked up by the config resync"

echo "== config resync =="
grep -q 'config-sync)     config_sync' src/ogn-maintenance \
    && ok "ogn-maintenance has a --config-sync mode" || bad "ogn-maintenance has a --config-sync mode"
grep -q 'ogn-config-sync.service' src/ogn-install \
    && ok "the installer writes the sync unit" || bad "the installer writes the sync unit"
# The whole point is that it runs before anything waits for a network that may
# be exactly what the edited card is trying to fix.
python3 - <<'PY' && ok "the sync unit runs before the network is waited on" || bad "the sync unit runs before the network is waited on"
import re, sys
unit = open("src/ogn-install").read().split("write_unit ogn-config-sync.service <<'EOF'", 1)[1].split("\nEOF", 1)[0]
assert re.search(r"^Before=.*network-online\.target", unit, re.M), "missing Before=network-online.target"
assert re.search(r"^Before=.*rtlsdr-ogn\.service", unit, re.M), "missing Before=rtlsdr-ogn.service"
assert "After=network-online.target" not in unit, "must not wait for the network"
PY
grep -q 'conf_digest         | boot_write "$CONFIG_APPLIED"' src/ogn-install \
    && ok "the installer records what the card said" || bad "the installer records what the card said"
grep -q 'conf_digest Install | boot_write "$INSTALL_APPLIED"' src/ogn-install \
    && ok "and records the Install settings separately" \
    || bad "and records the Install settings separately"
grep -q 'cat "$CONFIG_APPLIED"' src/ogn-maintenance \
    && ok "an unchanged card does no work" || bad "an unchanged card does no work"
# The marker has to outlive the overlay, or every boot re-detects the same
# edit for ever. /var/lib is in RAM once the overlay is on; the card is not.
grep -q 'CONFIG_APPLIED="$STATE_DIR/config.applied"' src/ogn-common.sh \
    && ok "the applied-config marker lives on the boot partition" \
    || bad "the applied-config marker lives on the boot partition"
grep -q 'ogn-install --no-reboot' src/ogn-maintenance \
    && ok "an installer re-run never reboots on its own" \
    || bad "an installer re-run never reboots on its own"
grep -q 'systemctl is-active --quiet rtlsdr-ogn.service' src/ogn-maintenance \
    && ok "the receiver is only restarted if it is already running" \
    || bad "the receiver is only restarted if it is already running"

echo "== calibration =="
conf_load boot/MyReceiver.conf
is "calibration is off by default"   "$(conf_get RF.Calibrate)"            "false"
is "FreqCorr starts at zero"         "$(conf_get RF.FreqCorr)"             "+0"

grep -q 'no Calibrate line in' src/ogn-calibrate \
    && ok "a card with no Calibrate line is refused, not looped" \
    || bad "a card with no Calibrate line is refused, not looped"

# The real write-back, through the real function. CenterFreq and Gain exist in
# both RF.GSM and RF.OGN, so an unscoped substitution would retune the receiver
# while recording a calibration -- the reason conf_set_value takes a block.
T=$(mktemp -d)
cp boot/MyReceiver.conf "$T/card.conf"
conf_set_value "$T/card.conf" Calibrate  true    "asked for"    || bad "arming Calibrate"
conf_set_value "$T/card.conf" FreqCorr   "+52"   "measured"     || bad "setting FreqCorr"
conf_set_value "$T/card.conf" CenterFreq "941.2" "measured" GSM || bad "setting GSM CenterFreq"
conf_set_value "$T/card.conf" Gain       "35.0"  "measured" GSM || bad "setting GSM Gain"
conf_load "$T/card.conf"
is "write-back sets FreqCorr"        "$(conf_get RF.FreqCorr)"       "+52"
is "write-back sets the GSM channel" "$(conf_get RF.GSM.CenterFreq)" "941.2"
is "write-back sets the GSM gain"    "$(conf_get RF.GSM.Gain)"       "35.0"
is "the OGN channel is untouched"    "$(conf_get RF.OGN.CenterFreq)" "868.8"
is "the OGN gain is untouched"       "$(conf_get RF.OGN.Gain)"       "50.0"
is "and SampleRate is untouched"     "$(conf_get RF.SampleRate)"     "2.0"

# Measuring again replaces the value rather than stacking a second line.
conf_set_value "$T/card.conf" FreqCorr "-3" "measured again" || bad "re-setting FreqCorr"
is "a second measurement replaces the first" \
    "$(grep -c '^ *FreqCorr *=' "$T/card.conf" | tr -d ' ')" "1"
conf_load "$T/card.conf"
is "and the new value is the one that counts" "$(conf_get RF.FreqCorr)" "-3"

# Disarming is what stops a three-minute scan repeating at every boot.
conf_set_value "$T/card.conf" Calibrate false "2026-01-01: measured" || bad "disarming"
conf_load "$T/card.conf"
is "write-back disarms Calibrate" "$(conf_get RF.Calibrate)" "false"

# An absent key is reported, never invented.
cp "$T/card.conf" "$T/before"
conf_set_value "$T/card.conf" Nonexistent 1 x \
    && bad "an absent key is refused" || ok "an absent key is refused"
cmp -s "$T/before" "$T/card.conf" \
    && ok "and the file is left alone" || bad "and the file is left alone"
rm -rf "$T"

# The config is libconfig, and upstream's own examples comment with #.
grep -q '^[[:space:]]*//' boot/MyReceiver.conf \
    && bad "the template comments with #, as upstream does" \
    || ok "the template comments with #, as upstream does"
grep -q 'printf "%s%s = %s;   # %s' src/ogn-common.sh \
    && ok "and the write-back emits # too" || bad "and the write-back emits # too"

# gsm_scan takes command-line flags. Every example says so: v2.1's configure
# called it that way, and upstream's own conf says "gsm_scan --gsm-850".
grep -q 'gsm_scan --ppm' src/ogn-calibrate \
    && ok "gsm_scan is called with flags, as the examples show" \
    || bad "gsm_scan is called with flags, as the examples show"

# gsm_scan defaults to device 0, which may be the ADS-B stick.
grep -q 'conf_get RF.DeviceSerial' src/ogn-calibrate \
    && ok "calibration follows DeviceSerial when it is set" \
    || bad "calibration follows DeviceSerial when it is set"
grep -q 'conf_get RF.Device 0' src/ogn-calibrate \
    && ok "and falls back to the Device index" \
    || bad "and falls back to the Device index"
grep -q 'gsm_scan --ppm 0 --gain "\$SCAN_GAIN" \$DEV_OPT' src/ogn-calibrate \
    && ok "and passes that selection to gsm_scan" \
    || bad "and passes that selection to gsm_scan"

grep -q 'conf_has RF.FreqCorr' src/ogn-install \
    && bad "the installer no longer calibrates unasked" \
    || ok "the installer no longer calibrates unasked"
grep -q 'ogn-calibrate --from-config' src/ogn-install \
    && ok "the installer honours a card that asks" \
    || bad "the installer honours a card that asks"
grep -q 'ogn-calibrate --from-config' src/ogn-maintenance \
    && ok "so does every later boot" || bad "so does every later boot"
grep -q 'systemctl stop rtlsdr-ogn.service' src/ogn-calibrate \
    && ok "calibration takes the SDR back from the receiver" \
    || bad "calibration takes the SDR back from the receiver"
grep -q 'trap .*restore_receiver. EXIT' src/ogn-calibrate \
    && ok "and gives it back however the scan ends" \
    || bad "and gives it back however the scan ends"
grep -q 'card_writeback "" ' src/ogn-calibrate \
    && ok "a failed scan still disarms itself" || bad "a failed scan still disarms itself"

echo "== generated vendor-data is in step with src/ =="
BEFORE=$(sha256sum boot/vendor-data 2>/dev/null || shasum -a 256 boot/vendor-data)
./tools/build-vendor-data >/dev/null
AFTER=$(sha256sum boot/vendor-data 2>/dev/null || shasum -a 256 boot/vendor-data)
is "boot/vendor-data is up to date" "${AFTER%% *}" "${BEFORE%% *}"
grep -q 'ogn-install' boot/vendor-data && ok "vendor-data hands over to ogn-install" || bad "vendor-data hands over to ogn-install"
grep -q 'rpi-connect' boot/vendor-data && ok "vendor-data carries the remote-admin code" || bad "vendor-data carries the remote-admin code"

echo "== image build =="
# build-image.sh downloads 550 MB and chroots, so the only thing that can be
# checked here is that it declines to do any of that on a workstation.
if [ "$(id -u)" -ne 0 ]; then
    OUT=$(./tools/build-image.sh 2>&1)
    if [ $? -ne 0 ] && printf '%s' "$OUT" | grep -qiE 'only works on Linux|must run as root'; then
        ok "build-image.sh refuses to run outside CI"
    else
        bad "build-image.sh refuses to run outside CI" "$OUT"
    fi
else
    printf '  skip running as root, so the refusal path cannot be checked safely\n'
fi

TMP=$(mktemp -d)
cat > "$TMP/meta.json" <<'JSON'
{ "name": "OGN Receiver", "file": "ogn-receiver-2026-01-01-arm64.img.xz",
  "extract_size": 3573547008, "extract_sha256": "beef",
  "image_download_size": 600000000, "image_download_sha256": "cafe",
  "release_date": "2026-01-01", "base_image": "base.img" }
JSON
URL="https://github.com/glidernet/ogn-bootstrap/releases/download/v3/ogn-receiver-2026-01-01-arm64.img.xz"

if ./tools/make-os-list --meta "$TMP/meta.json" --url "$URL" --out "$TMP/os-list.json" >/dev/null; then
    ok "make-os-list produces a list"
    python3 - "$TMP/os-list.json" <<'PY' && ok "os-list.json has what Imager requires" || bad "os-list.json has what Imager requires"
import json, sys
e = json.load(open(sys.argv[1]))["os_list"][0]
required = ("name", "description", "icon", "url", "extract_size",
            "extract_sha256", "image_download_size", "release_date", "devices")
missing = [k for k in required if not e.get(k)]
assert not missing, missing
# cloudinit-rpi is what keeps the Imager customisation wizard working.
assert e["init_format"] == "cloudinit-rpi", e["init_format"]
assert e["devices"] and all(d.endswith("-64bit") for d in e["devices"]), e["devices"]
PY
else
    bad "make-os-list produces a list"
fi

./tools/make-os-list --meta "$TMP/meta.json" --url "${URL/https/http}" --out "$TMP/x.json" >/dev/null 2>&1 \
    && bad "make-os-list rejects a plain-http download URL" \
    || ok "make-os-list rejects a plain-http download URL"
./tools/make-os-list --meta "$TMP/meta.json" --url "https://example.com/other.img.xz" --out "$TMP/x.json" >/dev/null 2>&1 \
    && bad "make-os-list rejects a URL the hashes do not describe" \
    || ok "make-os-list rejects a URL the hashes do not describe"

# Imager shows the name and the description and nothing else, so those two
# fields are the only place a test build can announce itself as one.
./tools/make-os-list --meta "$TMP/meta.json" --url "$URL" --out "$TMP/test.json" \
    --name "OGN Receiver TEST somebranch (abc1234)" \
    --note "TEST BUILD -- not the released receiver image." >/dev/null \
    && python3 - "$TMP/test.json" <<'PY' && ok "make-os-list labels a test build" || bad "make-os-list labels a test build"
import json, sys
e = json.load(open(sys.argv[1]))["os_list"][0]
assert e["name"] == "OGN Receiver TEST somebranch (abc1234)", e["name"]
assert e["description"].startswith("TEST BUILD"), e["description"]
PY
rm -rf "$TMP"

BEFORE=$(sha256sum doc/ogn-icon.png 2>/dev/null || shasum -a 256 doc/ogn-icon.png)
python3 tools/make-icon >/dev/null
AFTER=$(sha256sum doc/ogn-icon.png 2>/dev/null || shasum -a 256 doc/ogn-icon.png)
is "doc/ogn-icon.png is reproducible" "${AFTER%% *}" "${BEFORE%% *}"

# The build job runs other people's package scripts as root. It must not be
# holding a token while it does. Guarding this in tests because it is the kind
# of line that gets "tidied" back in later.
W=.github/workflows/build-image.yml
grep -q 'persist-credentials: false' "$W" \
    && ok "checkout does not leave credentials for the chroot" \
    || bad "checkout does not leave credentials for the chroot"
python3 - "$W" <<'PY' && ok "the build job has no write permissions" || bad "the build job has no write permissions"
import re, sys
text = open(sys.argv[1]).read()
build = text.split("  build:", 1)[1].split("\n  publish:", 1)[0]
assert re.search(r"^\s+permissions:\s*\{\}\s*$", build, re.M), "build job is missing 'permissions: {}'"
assert "contents: write" not in build, "build job grants contents: write"
PY

echo
printf '%s passed, %s failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
