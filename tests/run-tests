#!/bin/bash
#
# run-tests — offline checks that need no Pi, no SDR and no network.
#
# These cover the parts that are pure logic: reading the config, validating a
# receiver name, resolving the version manifest, and keeping boot/vendor-data
# in step with src/. Installing packages, driving systemd and enabling the
# overlay can only honestly be tested on real hardware; see the README.
#
# Copyright (c) 2026 ifly7charlie. MIT licence, see LICENSE.

set -uo pipefail
cd "$(dirname "$0")/.."

PASS=0; FAIL=0
ok()   { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
bad()  { FAIL=$((FAIL+1)); printf '  FAIL %s\n' "$1"; [ $# -gt 1 ] && printf '       %s\n' "$2"; }
is()   { if [ "$2" = "$3" ]; then ok "$1"; else bad "$1" "expected [$3], got [$2]"; fi; }
# Code with the comments stripped. Several of the names below appear in
# comments on purpose, explaining what is deliberately no longer used, so a
# plain grep would match the explanation and report the bug it warns about.
code_of() { sed 's/[[:space:]]#.*$//; /^[[:space:]]*#/d' "$@"; }

export OGN_LIBDIR="$PWD/src"
# shellcheck source=src/ogn-common.sh
. src/ogn-common.sh

echo "== shell syntax =="
for f in src/ogn-* tools/build-vendor-data tools/build-image.sh tests/run-tests boot/vendor-data; do
    case "$f" in *ogn-common.sh) continue ;; esac
    if bash -n "$f" 2>/dev/null; then ok "$f parses"; else bad "$f parses"; fi
done
bash -n src/ogn-common.sh && ok "src/ogn-common.sh parses" || bad "src/ogn-common.sh parses"

echo "== shellcheck =="
if command -v shellcheck >/dev/null; then
    if shellcheck -S warning src/ogn-* tools/build-vendor-data tools/build-image.sh 2>&1; then
        ok "shellcheck clean"
    else
        bad "shellcheck reported problems"
    fi
else
    printf '  skip shellcheck not installed\n'
fi

echo "== config parser: the shipped template =="
conf_load boot/MyReceiver.conf
is "Call defaults to empty"        "$(conf_get APRS.Call '<none>')"            "<none>"
is "Latitude"                      "$(conf_get Position.Latitude)"             "+0.0000"
is "Altitude"                      "$(conf_get Position.Altitude)"             "0"
is "SampleRate"                    "$(conf_get RF.SampleRate)"                 "2.0"
is "nested CenterFreq"             "$(conf_get RF.OGN.CenterFreq)"             "868.8"
is "HTTP port"                     "$(conf_get HTTP.Port)"                     "8082"
is "UpdateChannel"                 "$(conf_get Install.UpdateChannel)"         "stable"
is "MaintenanceWindow keeps spaces" "$(conf_get Install.MaintenanceWindow)"    "Sun *-*-* 03:00:00"
is "deeply nested RemoteAdmin"     "$(conf_get Install.RemoteAdmin.Connect)"   "false"
is "FreqCorr ships as zero"        "$(conf_get RF.FreqCorr)"                   "+0"
is "GSM tracking ships switched off" "$(conf_get RF.GSM.CenterFreq)"           "0"
is "GSM gain is not the OGN gain"  "$(conf_get RF.GSM.Gain)"                   "25.0"
is "GeoidSepar deliberately absent"   "$(conf_get Position.GeoidSepar '<none>')" "<none>"

# Dongle selection.
is "Device selects the first stick" "$(conf_get RF.Device)"                     "0"
is "DeviceSerial ships commented out" "$(conf_get RF.DeviceSerial '<none>')"    "<none>"

# ADS-B is opt-in by absence.
is "no ADSB section, so ADS-B is off" "$(conf_get ADSB.AVR '<none>')"           "<none>"
is "and no MaxAlt either"             "$(conf_get ADSB.MaxAlt '<none>')"        "<none>"
grep -q '^# ADSB:' boot/MyReceiver.conf \
    && ok "the ADSB section is present but commented" \
    || bad "the ADSB section is present but commented"

# 8080 is left free for dump1090/readsb/tar1090.
grep -qE '^[[:space:]]*Port[[:space:]]*=[[:space:]]*8080' boot/MyReceiver.conf \
    && bad "8080 is left free for an ADS-B map" \
    || ok "8080 is left free for an ADS-B map"
conf_bool Install.ReadOnlyFS            && ok "ReadOnlyFS reads as true"  || bad "ReadOnlyFS reads as true"
conf_bool Install.RemoteAdmin.OGNTeam   && bad "OGNTeam reads as false"   || ok "OGNTeam reads as false"
conf_bool Nothing.At.All                && bad "missing key is false"     || ok "missing key is false"

echo "== config parser: awkward input =="
conf_load tests/fixtures/awkward.conf
is "// inside a string survives"   "$(conf_get Strings.WithSlashes)" "http://example.com/not?a=comment"
is "# inside a string survives"    "$(conf_get Strings.WithHash)"    "a # b"
is "; inside a string survives"    "$(conf_get Strings.WithSemi)"    "a ; b"
is "braces inside a string"        "$(conf_get Strings.WithBrace)"   "a } b {"
is "escaped quotes"                "$(conf_get Strings.WithEscape)"  'she said \"hello\"'
is "trailing // comment ignored"   "$(conf_get APRS.Call)"           "Tricky9"
is "block comment ignored"         "$(conf_get Position.Latitude)"   "-33.9500"
is "blank line does not reset"     "$(conf_get Position.Altitude)"   "128"
is "three levels deep"             "$(conf_get Nest.Level2.Level3.Deep)" "42"
is "sibling after a nested close"  "$(conf_get Nest.Sibling)"        "false"
is "value after an array"          "$(conf_get Arrays.After)"        "7"
is "empty string uses the default" "$(conf_get Strings.Empty 'dflt')" "dflt"

echo "== receiver name validation =="
check_name() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9]{1,9}$'; }
for good in Lasham EGHL Salanda Lennrtsns9 a 123456789; do
    case "$good" in Lennrtsns9) continue ;; esac
    check_name "$good" && ok "accepts '$good'" || bad "accepts '$good'"
done
for bad_name in "" "Ten2Longer" "has space" "has-dash" "üml" "a_b"; do
    check_name "$bad_name" && bad "rejects '$bad_name'" || ok "rejects '$bad_name'"
done

echo "== manifest =="
python3 -c 'import json;json.load(open("versions.json"))' && ok "versions.json is valid JSON" || bad "versions.json is valid JSON"
MANIFEST_CACHE="$PWD/versions.json"
is "stable resolves"        "$(manifest_resolve stable)"   "0.3.2"
is "exact version resolves" "$(manifest_resolve 0.3.2)"    "0.3.2"
manifest_resolve 9.9.9 >/dev/null 2>&1 && bad "unknown version is rejected" || ok "unknown version is rejected"
is "arm64 url"              "$(manifest_field 0.3.2 arm64 url)" \
                            "http://download.glidernet.org/arm64/rtlsdr-ogn-bin-arm64-0.3.2.tgz"
case "$(manifest_field 0.3.2 arm64 sha256)" in
    None|null|"") ok "sha256 is still unset, so ogn-update will refuse to install" ;;
    *)            ok "sha256 is populated" ;;
esac

echo "== SD card write protection =="
for fn in boot_rw boot_ro boot_write; do
    type "$fn" >/dev/null 2>&1 && ok "$fn is defined" || bad "$fn is defined"
done
grep -q 'Storage=volatile' src/ogn-install && ok "journal is pinned to RAM" || bad "journal is pinned to RAM"
grep -q 'RuntimeMaxUse' src/ogn-install && ok "journal size is capped" || bad "journal size is capped"
grep -q 'boot_partition_ro' src/ogn-install && ok "boot partition is set read-only" || bad "boot partition is set read-only"
# raspi-config has no do_bootro entry point; enable_bootro is internal.
code_of src/ogn-install | grep -q 'do_bootro' \
    && bad "no call to the non-existent raspi-config do_bootro" \
    || ok "no call to the non-existent raspi-config do_bootro"
grep -q 'rsyslog' src/ogn-install && ok "rsyslog is disabled if present" || bad "rsyslog is disabled if present"
grep -q 'boot_write "$STATE_FILE"' src/ogn-maintenance && ok "marker writes go through boot_write" || bad "marker writes go through boot_write"
grep -q '\[ -e "$STATE_FILE" \] || return 0' src/ogn-maintenance \
    && ok "idle boots do not write to the card" || bad "idle boots do not write to the card"

echo "== read-only overlay =="
# Detection and the switch must name the same marker, or the overlay never
# reads as enabled and maintenance writes its updates into RAM.
is "one marker, defined once" "$OVERLAY_PARAM" "overlayroot=tmpfs"
code_of src/ogn-* | grep -q 'do_overlayfs' \
    && bad "raspi-config's overlay mechanism is not used" \
    || ok "raspi-config's overlay mechanism is not used"
code_of src/ogn-* | grep -q 'boot=overlay' \
    && bad "no leftover boot=overlay marker" || ok "no leftover boot=overlay marker"
for fn in overlay_active overlay_next_boot overlay_status cmdline_write \
          overlay_preflight overlay_ensure_initramfs swap_disable; do
    type "$fn" >/dev/null 2>&1 && ok "$fn is defined" || bad "$fn is defined"
done

# The switch lives on the FAT partition: /etc is hidden by the overlay it
# would be configuring.
grep -q 'CMDLINE_FILE="$BOOT_DIR/cmdline.txt"' src/ogn-common.sh \
    && ok "the switch is on the boot partition" || bad "the switch is on the boot partition"
code_of src/ogn-* | grep -q 'overlayroot\.conf' \
    && bad "nothing depends on /etc/overlayroot.conf" \
    || ok "nothing depends on /etc/overlayroot.conf"

# cmdline.txt rewriting, for real: a truncated or two-line cmdline.txt is an
# unbootable Pi, so this is worth exercising rather than grepping for.
T=$(mktemp -d)
BASE='console=serial0,115200 root=PARTUUID=abc rootfstype=ext4 fsck.repair=yes rootwait'
CMDLINE_FILE="$T/cmdline.txt"
printf '%s\n' "$BASE" > "$CMDLINE_FILE"
cmdline_write "$OVERLAY_PARAM" 1 >/dev/null 2>&1
is "enabling appends the parameter" "$(cat "$CMDLINE_FILE")" "$BASE $OVERLAY_PARAM"
is "and cmdline.txt stays one line"  "$(wc -l < "$CMDLINE_FILE" | tr -d ' ')" "1"
cmdline_write "$OVERLAY_PARAM" 1 >/dev/null 2>&1
is "enabling twice does not duplicate it" \
    "$(grep -c -o "$OVERLAY_PARAM" "$CMDLINE_FILE" | tr -d ' ')" "1"
cmdline_write "$OVERLAY_PARAM" 0 >/dev/null 2>&1
is "disabling removes it, leaving the rest alone" "$(cat "$CMDLINE_FILE")" "$BASE"
cmdline_write "$OVERLAY_PARAM" 0 >/dev/null 2>&1
is "disabling twice is harmless" "$(cat "$CMDLINE_FILE")" "$BASE"
: > "$CMDLINE_FILE"
cmdline_write "$OVERLAY_PARAM" 1 >/dev/null 2>&1 \
    && bad "an empty cmdline.txt is refused, not written" \
    || ok "an empty cmdline.txt is refused, not written"
rm -rf "$T"
CMDLINE_FILE="$BOOT_DIR/cmdline.txt"

# The hand-operated command. `overlay` is the name people are told to type.
grep -q 'ln -sfn ogn-overlay /usr/local/sbin/overlay' boot/vendor-data \
    && ok "vendor-data installs the 'overlay' command" \
    || bad "vendor-data installs the 'overlay' command"
grep -q 'ln -sfn ogn-overlay' tools/build-image.sh \
    && ok "and so does the image build" || bad "and so does the image build"
for verb in 'on|enable' 'off|disable' 'status'; do
    grep -qE "^ *$verb\)" src/ogn-overlay \
        && ok "overlay takes '$verb'" || bad "overlay takes '$verb'"
done
# Checking the state should not need sudo; changing it must.
S=$(grep -n 'ACTION" = status' src/ogn-overlay | head -1 | cut -d: -f1)
R=$(grep -n '^need_root' src/ogn-overlay | head -1 | cut -d: -f1)
if [ -n "$S" ] && [ -n "$R" ] && [ "$S" -lt "$R" ]; then
    ok "overlay status works without sudo, changes do not"
else
    bad "overlay status works without sudo, changes do not"
fi
# Arming a parameter with no initramfs to act on boots normally and keeps
# writing to the card, with nothing to say so. Refuse instead.
grep -q 'overlay_preflight' src/ogn-overlay \
    && ok "enabling checks it would actually engage" \
    || bad "enabling checks it would actually engage"
grep -q 'auto_initramfs=1' src/ogn-common.sh \
    && ok "an initramfs is arranged for, by a name that survives kernel upgrades" \
    || bad "an initramfs is arranged for, by a name that survives kernel upgrades"

# The login banner, refreshed at every boot.
type overlay_motd_update >/dev/null 2>&1 \
    && ok "overlay_motd_update is defined" || bad "overlay_motd_update is defined"
grep -q 'overlay_motd_update' src/ogn-maintenance \
    && ok "the boot-time config sync refreshes it" \
    || bad "the boot-time config sync refreshes it"
grep -q 'overlay_motd_update' src/ogn-install \
    && ok "the installer writes it once set up" || bad "the installer writes it once set up"
is "overlay_motd_update runs before config_sync can bail out" \
    "$(awk '/^config_sync\(\)/,/BOOT_CONF" \]/' src/ogn-maintenance | grep -c 'overlay_motd_update')" "1"
grep -c 'overlay_motd_update' src/ogn-overlay | grep -q '^2$' \
    && ok "both overlay on and overlay off refresh it" \
    || bad "both overlay on and overlay off refresh it"

# All four states say something.
T=$(mktemp -d)
OVERLAY_MOTD="$T/motd"
for now in 0 1; do
    for next in 0 1; do
        eval "overlay_active()    { return $((1 - now)); }"
        eval "overlay_next_boot() { return $((1 - next)); }"
        overlay_motd_update
        if [ -s "$OVERLAY_MOTD" ]; then
            ok "active=$now next=$next produces a banner"
        else
            bad "active=$now next=$next produces a banner"
        fi
    done
done
# The one state worth shouting about.
overlay_active()    { return 1; }
overlay_next_boot() { return 1; }
overlay_motd_update
grep -q 'WRITABLE' "$OVERLAY_MOTD" \
    && ok "an unprotected receiver says so loudly" || bad "an unprotected receiver says so loudly"
# Rewriting identical content would be a pointless SD card write every boot.
cp "$OVERLAY_MOTD" "$T/before"
touch -t 200001010000 "$OVERLAY_MOTD"
overlay_motd_update
if [ "$OVERLAY_MOTD" -nt "$T/before" ]; then
    bad "an unchanged banner is not rewritten at every boot"
else
    ok "an unchanged banner is not rewritten at every boot"
fi
rm -rf "$T"
unset -f overlay_active overlay_next_boot
. src/ogn-common.sh

echo "== wifi from the card =="
conf_load boot/MyReceiver.conf
is "shipped template leaves SSID empty" "$(conf_get Network.Wifi.SSID '<empty>')" "<empty>"
is "shipped template leaves the country empty" "$(conf_get Network.Wifi.Country '<empty>')" "<empty>"
conf_bool Network.Wifi.Hidden && bad "Hidden defaults to false" || ok "Hidden defaults to false"

# A stub nmcli, so the logic can be exercised without a radio. It records the
# command line and reports that nothing is configured yet.
STUB=$(mktemp -d)
export NMCLI_LOG="$STUB/calls"
: > "$NMCLI_LOG"
cat > "$STUB/nmcli" <<'STUBEOF'
#!/bin/bash
printf '%s\n' "$*" >> "$NMCLI_LOG"
case "$*" in
    "general status")            exit 0 ;;
    *"-f DEVICE,TYPE device"*)   printf 'eth0:ethernet\nwlan0:wifi\n'; exit 0 ;;
    *"connection show"*)         exit 1 ;;   # nothing configured yet
    *)                           exit 0 ;;
esac
STUBEOF
chmod +x "$STUB/nmcli"
OLD_PATH="$PATH"; PATH="$STUB:$PATH"

# The shipped template must not touch the network at all: the wifi Imager
# configured is the normal case, and this option exists only to override it.
wifi_apply >/dev/null 2>&1
is "an empty SSID calls nmcli not at all" "$(wc -l < "$NMCLI_LOG" | tr -d ' ')" "0"

conf_load tests/fixtures/wifi.conf
is "SSID with a space survives"   "$(conf_get Network.Wifi.SSID)"     "Clubhouse 5G"
is "password with a space survives" "$(conf_get Network.Wifi.Password)" "correct horse"
conf_bool Network.Wifi.Hidden && ok "Hidden reads as true" || bad "Hidden reads as true"

wifi_apply >/dev/null 2>&1
CALLS=$(cat "$NMCLI_LOG")
case "$CALLS" in
    *"connection add type wifi con-name ogn-wifi ifname wlan0 ssid Clubhouse 5G"*)
        ok "creates ogn-wifi on the wifi interface" ;;
    *)  bad "creates ogn-wifi on the wifi interface" "$CALLS" ;;
esac
case "$CALLS" in
    *"802-11-wireless-security.psk correct horse"*) ok "sets the password" ;;
    *) bad "sets the password" "$CALLS" ;;
esac
case "$CALLS" in
    *"802-11-wireless.hidden yes"*) ok "passes Hidden through" ;;
    *) bad "passes Hidden through" "$CALLS" ;;
esac
case "$CALLS" in
    *"connection up ogn-wifi"*) ok "brings the connection up" ;;
    *) bad "brings the connection up" "$CALLS" ;;
esac
case "$CALLS" in
    *"autoconnect-priority 10"*) ok "outranks whatever Imager configured" ;;
    *) bad "outranks whatever Imager configured" "$CALLS" ;;
esac

# Already correct: nothing to do, and in particular no write to a persisted
# NetworkManager keyfile on every boot.
cat > "$STUB/nmcli" <<'STUBEOF'
#!/bin/bash
printf '%s\n' "$*" >> "$NMCLI_LOG"
case "$*" in
    "general status")                exit 0 ;;
    *"-f DEVICE,TYPE device"*)       printf 'wlan0:wifi\n'; exit 0 ;;
    *"802-11-wireless.ssid connection show"*)           printf 'Clubhouse 5G\n'; exit 0 ;;
    *"802-11-wireless-security.psk connection show"*)   printf 'correct horse\n'; exit 0 ;;
    *"802-11-wireless.hidden connection show"*)         printf 'yes\n'; exit 0 ;;
    *"connection add"*|*"connection delete"*|*"connection up"*) printf 'CHANGED\n' >> "$NMCLI_LOG"; exit 0 ;;
    *)                               exit 0 ;;
esac
STUBEOF
: > "$NMCLI_LOG"
wifi_apply >/dev/null 2>&1
grep -q CHANGED "$NMCLI_LOG" && bad "an already-correct wifi is left alone" || ok "an already-correct wifi is left alone"

# No wifi interface at all (a Pi on ethernet with the option set by mistake):
# warn, do not fail the boot.
cat > "$STUB/nmcli" <<'STUBEOF'
#!/bin/bash
case "$*" in
    "general status")          exit 0 ;;
    *"-f DEVICE,TYPE device"*) printf 'eth0:ethernet\n'; exit 0 ;;
    *)                         exit 0 ;;
esac
STUBEOF
wifi_apply >/dev/null 2>&1 && ok "no wifi interface is survivable" || bad "no wifi interface is survivable"

PATH="$OLD_PATH"; rm -rf "$STUB"; unset NMCLI_LOG

echo "== config resync =="
grep -q 'config-sync)     config_sync' src/ogn-maintenance \
    && ok "ogn-maintenance has a --config-sync mode" || bad "ogn-maintenance has a --config-sync mode"
grep -q 'ogn-config-sync.service' src/ogn-install \
    && ok "the installer writes the sync unit" || bad "the installer writes the sync unit"
# The whole point is that it runs before anything waits for a network that may
# be exactly what the edited card is trying to fix.
python3 - <<'PY' && ok "the sync unit runs before the network is waited on" || bad "the sync unit runs before the network is waited on"
import re, sys
unit = open("src/ogn-install").read().split("write_unit ogn-config-sync.service <<'EOF'", 1)[1].split("\nEOF", 1)[0]
assert re.search(r"^Before=.*network-online\.target", unit, re.M), "missing Before=network-online.target"
assert re.search(r"^Before=.*rtlsdr-ogn\.service", unit, re.M), "missing Before=rtlsdr-ogn.service"
assert "After=network-online.target" not in unit, "must not wait for the network"
PY
grep -q 'conf_digest         | boot_write "$CONFIG_APPLIED"' src/ogn-install \
    && ok "the installer records what the card said" || bad "the installer records what the card said"
grep -q 'conf_digest Install | boot_write "$INSTALL_APPLIED"' src/ogn-install \
    && ok "and records the Install settings separately" \
    || bad "and records the Install settings separately"
grep -q 'cat "$CONFIG_APPLIED"' src/ogn-maintenance \
    && ok "an unchanged card does no work" || bad "an unchanged card does no work"
# The marker has to outlive the overlay, or every boot re-detects the same
# edit for ever. /var/lib is in RAM once the overlay is on; the card is not.
grep -q 'CONFIG_APPLIED="$STATE_DIR/config.applied"' src/ogn-common.sh \
    && ok "the applied-config marker lives on the boot partition" \
    || bad "the applied-config marker lives on the boot partition"
grep -q 'ogn-install --no-reboot' src/ogn-maintenance \
    && ok "an installer re-run never reboots on its own" \
    || bad "an installer re-run never reboots on its own"
grep -q 'systemctl is-active --quiet rtlsdr-ogn.service' src/ogn-maintenance \
    && ok "the receiver is only restarted if it is already running" \
    || bad "the receiver is only restarted if it is already running"

echo "== calibration =="
conf_load boot/MyReceiver.conf
is "calibration is off by default"   "$(conf_get RF.Calibrate)"            "false"
is "FreqCorr starts at zero"         "$(conf_get RF.FreqCorr)"             "+0"

grep -q 'no Calibrate line in' src/ogn-calibrate \
    && ok "a card with no Calibrate line is refused, not looped" \
    || bad "a card with no Calibrate line is refused, not looped"

# The real write-back, through the real function. CenterFreq and Gain exist in
# both RF.GSM and RF.OGN, so an unscoped substitution would retune the receiver
# while recording a calibration -- the reason conf_set_value takes a block.
T=$(mktemp -d)
cp boot/MyReceiver.conf "$T/card.conf"
conf_set_value "$T/card.conf" Calibrate  true    "asked for"    || bad "arming Calibrate"
conf_set_value "$T/card.conf" FreqCorr   "+52"   "measured"     || bad "setting FreqCorr"
conf_set_value "$T/card.conf" CenterFreq "941.2" "measured" GSM || bad "setting GSM CenterFreq"
conf_set_value "$T/card.conf" Gain       "35.0"  "measured" GSM || bad "setting GSM Gain"
conf_load "$T/card.conf"
is "write-back sets FreqCorr"        "$(conf_get RF.FreqCorr)"       "+52"
is "write-back sets the GSM channel" "$(conf_get RF.GSM.CenterFreq)" "941.2"
is "write-back sets the GSM gain"    "$(conf_get RF.GSM.Gain)"       "35.0"
is "the OGN channel is untouched"    "$(conf_get RF.OGN.CenterFreq)" "868.8"
is "the OGN gain is untouched"       "$(conf_get RF.OGN.Gain)"       "50.0"
is "and SampleRate is untouched"     "$(conf_get RF.SampleRate)"     "2.0"

# Measuring again replaces the value rather than stacking a second line.
conf_set_value "$T/card.conf" FreqCorr "-3" "measured again" || bad "re-setting FreqCorr"
is "a second measurement replaces the first" \
    "$(grep -c '^ *FreqCorr *=' "$T/card.conf" | tr -d ' ')" "1"
conf_load "$T/card.conf"
is "and the new value is the one that counts" "$(conf_get RF.FreqCorr)" "-3"

# Disarming is what stops a three-minute scan repeating at every boot.
conf_set_value "$T/card.conf" Calibrate false "2026-01-01: measured" || bad "disarming"
conf_load "$T/card.conf"
is "write-back disarms Calibrate" "$(conf_get RF.Calibrate)" "false"

# An absent key is reported, never invented.
cp "$T/card.conf" "$T/before"
conf_set_value "$T/card.conf" Nonexistent 1 x \
    && bad "an absent key is refused" || ok "an absent key is refused"
cmp -s "$T/before" "$T/card.conf" \
    && ok "and the file is left alone" || bad "and the file is left alone"
rm -rf "$T"

# The config is libconfig, and upstream's own examples comment with #.
grep -q '^[[:space:]]*//' boot/MyReceiver.conf \
    && bad "the template comments with #, as upstream does" \
    || ok "the template comments with #, as upstream does"
grep -q 'printf "%s%s = %s;   # %s' src/ogn-common.sh \
    && ok "and the write-back emits # too" || bad "and the write-back emits # too"

# gsm_scan takes command-line flags. Every example says so: v2.1's configure
# called it that way, and upstream's own conf says "gsm_scan --gsm-850".
grep -q 'gsm_scan --ppm' src/ogn-calibrate \
    && ok "gsm_scan is called with flags, as the examples show" \
    || bad "gsm_scan is called with flags, as the examples show"

# gsm_scan defaults to device 0, which may be the ADS-B stick.
grep -q 'conf_get RF.DeviceSerial' src/ogn-calibrate \
    && ok "calibration follows DeviceSerial when it is set" \
    || bad "calibration follows DeviceSerial when it is set"
grep -q 'conf_get RF.Device 0' src/ogn-calibrate \
    && ok "and falls back to the Device index" \
    || bad "and falls back to the Device index"
grep -q 'gsm_scan --ppm 0 --gain "\$SCAN_GAIN" \$DEV_OPT' src/ogn-calibrate \
    && ok "and passes that selection to gsm_scan" \
    || bad "and passes that selection to gsm_scan"

grep -q 'conf_has RF.FreqCorr' src/ogn-install \
    && bad "the installer no longer calibrates unasked" \
    || ok "the installer no longer calibrates unasked"
grep -q 'ogn-calibrate --from-config' src/ogn-install \
    && ok "the installer honours a card that asks" \
    || bad "the installer honours a card that asks"
grep -q 'ogn-calibrate --from-config' src/ogn-maintenance \
    && ok "so does every later boot" || bad "so does every later boot"
grep -q 'systemctl stop rtlsdr-ogn.service' src/ogn-calibrate \
    && ok "calibration takes the SDR back from the receiver" \
    || bad "calibration takes the SDR back from the receiver"
grep -q 'trap .*restore_receiver. EXIT' src/ogn-calibrate \
    && ok "and gives it back however the scan ends" \
    || bad "and gives it back however the scan ends"
grep -q 'card_writeback "" ' src/ogn-calibrate \
    && ok "a failed scan still disarms itself" || bad "a failed scan still disarms itself"

echo "== generated vendor-data is in step with src/ =="
BEFORE=$(sha256sum boot/vendor-data 2>/dev/null || shasum -a 256 boot/vendor-data)
./tools/build-vendor-data >/dev/null
AFTER=$(sha256sum boot/vendor-data 2>/dev/null || shasum -a 256 boot/vendor-data)
is "boot/vendor-data is up to date" "${AFTER%% *}" "${BEFORE%% *}"
grep -q 'ogn-install' boot/vendor-data && ok "vendor-data hands over to ogn-install" || bad "vendor-data hands over to ogn-install"
grep -q 'rpi-connect' boot/vendor-data && ok "vendor-data carries the remote-admin code" || bad "vendor-data carries the remote-admin code"

echo "== image build =="
# build-image.sh downloads 550 MB and chroots, so the only thing that can be
# checked here is that it declines to do any of that on a workstation.
if [ "$(id -u)" -ne 0 ]; then
    OUT=$(./tools/build-image.sh 2>&1)
    if [ $? -ne 0 ] && printf '%s' "$OUT" | grep -qiE 'only works on Linux|must run as root'; then
        ok "build-image.sh refuses to run outside CI"
    else
        bad "build-image.sh refuses to run outside CI" "$OUT"
    fi
else
    printf '  skip running as root, so the refusal path cannot be checked safely\n'
fi

TMP=$(mktemp -d)
cat > "$TMP/meta.json" <<'JSON'
{ "name": "OGN Receiver", "file": "ogn-receiver-2026-01-01-arm64.img.xz",
  "extract_size": 3573547008, "extract_sha256": "beef",
  "image_download_size": 600000000, "image_download_sha256": "cafe",
  "release_date": "2026-01-01", "base_image": "base.img" }
JSON
URL="https://github.com/glidernet/ogn-bootstrap/releases/download/v3/ogn-receiver-2026-01-01-arm64.img.xz"

if ./tools/make-os-list --meta "$TMP/meta.json" --url "$URL" --out "$TMP/os-list.json" >/dev/null; then
    ok "make-os-list produces a list"
    python3 - "$TMP/os-list.json" <<'PY' && ok "os-list.json has what Imager requires" || bad "os-list.json has what Imager requires"
import json, sys
e = json.load(open(sys.argv[1]))["os_list"][0]
required = ("name", "description", "icon", "url", "extract_size",
            "extract_sha256", "image_download_size", "release_date", "devices")
missing = [k for k in required if not e.get(k)]
assert not missing, missing
# cloudinit-rpi is what keeps the Imager customisation wizard working.
assert e["init_format"] == "cloudinit-rpi", e["init_format"]
assert e["devices"] and all(d.endswith("-64bit") for d in e["devices"]), e["devices"]
PY
else
    bad "make-os-list produces a list"
fi

./tools/make-os-list --meta "$TMP/meta.json" --url "${URL/https/http}" --out "$TMP/x.json" >/dev/null 2>&1 \
    && bad "make-os-list rejects a plain-http download URL" \
    || ok "make-os-list rejects a plain-http download URL"
./tools/make-os-list --meta "$TMP/meta.json" --url "https://example.com/other.img.xz" --out "$TMP/x.json" >/dev/null 2>&1 \
    && bad "make-os-list rejects a URL the hashes do not describe" \
    || ok "make-os-list rejects a URL the hashes do not describe"

# Imager shows the name and the description and nothing else, so those two
